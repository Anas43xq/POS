<UserControl x:Class="UI.Controls.CrudActionButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="28" d:DesignWidth="360">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

        <Button Style="{StaticResource POS.Button.Primary}"
                Margin="{StaticResource Spacing.HeaderActionGap}"
                Command="{Binding AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding AddLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="{StaticResource Font.Size.Base}"
                           FontWeight="{StaticResource Font.Weight.Medium}"/>
            </StackPanel>
        </Button>

        <Button Style="{StaticResource POS.Button.CrudEdit}"
                Margin="{StaticResource Spacing.HeaderActionGap}"
                Command="{Binding EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding EditLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="{StaticResource Font.Size.Base}"/>
            </StackPanel>
        </Button>

        <Button Style="{StaticResource POS.Button.CrudDelete}"
                Margin="{StaticResource Spacing.HeaderActionGap}"
                Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DeleteLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="{StaticResource Font.Size.Base}"/>
            </StackPanel>
        </Button>

        <Button Style="{StaticResource POS.Button.Secondary}"
                Margin="{StaticResource Spacing.HeaderActionGap}"
                Visibility="{Binding ShowTranslations, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                Command="{Binding TranslationsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🌐  "
                           FontSize="{StaticResource Font.Size.Base}"/>
                <TextBlock Text="{Binding TranslationsLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="{StaticResource Font.Size.Base}"/>
            </StackPanel>
        </Button>

        <StackPanel Orientation="Horizontal"
                    Visibility="{Binding ShowRefresh, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button Style="{StaticResource POS.Button.Secondary}"
                    Command="{Binding RefreshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding RefreshLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="{StaticResource Font.Size.Base}"/>
                </StackPanel>
            </Button>
        </StackPanel>

    </StackPanel>
</UserControl>
