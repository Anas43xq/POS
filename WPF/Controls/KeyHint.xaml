<UserControl x:Class="UI.Controls.KeyHint"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">

    <Border CornerRadius="{StaticResource Radius.Sm}"
            Padding="3,1"
            Background="{Binding BadgeBackground, ElementName=root}"
            BorderBrush="{Binding BadgeBorderBrush, ElementName=root}"
            BorderThickness="{Binding BadgeBorderThickness, ElementName=root}">
        <TextBlock Text="{Binding Key, ElementName=root}"
                   Foreground="{Binding BadgeForeground, ElementName=root}"
                   FontSize="{StaticResource Font.Size.Xs}"
                   FontWeight="{StaticResource Font.Weight.Medium}"
                   FontFamily="Consolas, Courier New, monospace"/>
    </Border>

</UserControl>
