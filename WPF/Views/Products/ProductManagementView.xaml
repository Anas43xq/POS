<UserControl x:Class="UI.Views.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1420" d:DesignHeight="820"
             Background="{StaticResource Color.Brand.Light}">

    <Grid Margin="{StaticResource Spacing.4}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource Color.Surface.Default}"
                BorderBrush="{StaticResource Color.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Lg}"
                Padding="{StaticResource Spacing.3}"
                Margin="{StaticResource Spacing.2}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Manager.Products.Title}"
                           FontSize="{StaticResource Font.Size.Lg}"
                           FontWeight="{StaticResource Font.Weight.SemiBold}"
                           Foreground="{StaticResource Color.Text.Default}"
                           VerticalAlignment="Center"/>

                <controls:CrudActionButtons Grid.Column="1" VerticalAlignment="Center"
                                             AddCommand="{Binding AddProductCommand}"
                                             AddLabel="{DynamicResource Common.Add}"
                                             EditCommand="{Binding EditProductCommand}"
                                             EditEnabled="{Binding CanEdit}"
                                             EditLabel="{DynamicResource Common.Edit}"
                                             DeleteCommand="{Binding DeleteProductCommand}"
                                             DeleteEnabled="{Binding CanDelete}"
                                             DeleteLabel="{DynamicResource Common.Delete}"
                                             RefreshCommand="{Binding RefreshCommand}"
                                             RefreshLabel="{DynamicResource Common.Refresh}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Color.Surface.Default}"
                    BorderBrush="{StaticResource Color.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}"
                    Padding="{StaticResource Spacing.3}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="{StaticResource Spacing.2}">
                        <TextBlock Text="{DynamicResource Manager.Products.CategoriesTitle}"
                                   FontSize="{StaticResource Font.Size.Lg}"
                                   FontWeight="{StaticResource Font.Weight.SemiBold}"
                                   Foreground="{StaticResource Color.Text.Default}"
                                   Margin="{StaticResource Spacing.2}"/>
                        <Border Background="{StaticResource Color.Surface.Subtle}"
                                BorderBrush="{StaticResource Color.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Md}"
                                Padding="{StaticResource Spacing.2}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="🔍"
                                           FontSize="{StaticResource Font.Size.Sm}"
                                           Margin="{StaticResource Spacing.RowIconGap}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource POS.TextBox.SearchInline}"
                                         Text="{Binding CategorySearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <TreeView ItemsSource="{Binding CategoryRoots}"
                                  BorderThickness="0"
                                  SelectedItemChanged="CategoryTree_SelectedItemChanged">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Spacing.Xxs}">
                                        <TextBlock Text="{Binding Icon}" Margin="{StaticResource Spacing.RowIconGap}"/>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Color.Text.Default}"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>

                        <TextBlock Text="{DynamicResource Manager.Products.EmptyCategorySearchMessage}"
                                   Style="{StaticResource POS.Manager.EmptyStateText}"
                                   Visibility="{Binding IsCategorySearchEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource Color.Surface.Default}"
                    BorderBrush="{StaticResource Color.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}"
                    Padding="{StaticResource Spacing.3}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource Spacing.2}">
                        <TextBlock Text="{DynamicResource Manager.Products.ProductsTitle}"
                                   FontSize="{StaticResource Font.Size.Lg}"
                                   FontWeight="{StaticResource Font.Weight.SemiBold}"
                                   Foreground="{StaticResource Color.Text.Default}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentCategoryLabel}"
                                   FontSize="{StaticResource Font.Size.Base}"
                                   Foreground="{StaticResource Color.Text.Muted}"
                                   Margin="{StaticResource Spacing.RowSectionGap}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{StaticResource Color.Surface.Subtle}"
                            BorderBrush="{StaticResource Color.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            Padding="{StaticResource Spacing.2}"
                            Margin="{StaticResource Spacing.2}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="🔍"
                                       FontSize="{StaticResource Font.Size.Sm}"
                                       Margin="{StaticResource Spacing.RowIconGap}"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource POS.TextBox.SearchInline}"
                                     Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="NoWrap"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="ProductsGrid"
                                  Style="{StaticResource POS.DataGrid.Default}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                  MouseDoubleClick="ProductsDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Manager.Products.ColProductName}" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="{DynamicResource Manager.Products.ColCategory}" Binding="{Binding CategoryName}" Width="1.5*"/>
                                <DataGridTextColumn Header="{DynamicResource Manager.Products.ColPrice}" Binding="{Binding PriceDisplay}" Width="110"/>
                                <DataGridTextColumn Header="{DynamicResource Manager.Products.ColStatus}" Binding="{Binding Status}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{DynamicResource Manager.Products.EmptyProductSearchMessage}"
                                   Style="{StaticResource POS.Manager.EmptyStateText}"
                                   Visibility="{Binding IsProductSearchEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
