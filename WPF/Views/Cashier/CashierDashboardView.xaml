<UserControl x:Class="UI.Views.Cashier.CashierDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             xmlns:cashier="clr-namespace:UI.Views.Cashier"
             xmlns:b="clr-namespace:UI.Behaviors"
             mc:Ignorable="d"
             d:DesignWidth="1600" d:DesignHeight="900"
             b:ShortcutBindingsBehavior.Role="Cashier">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3"
                Background="{StaticResource Color.Surface.AppBackground}"/>

        <cashier:CashierHeaderView Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="288"/>
            </Grid.ColumnDefinitions>

            <cashier:ProductsPanelView Grid.Column="0"/>
            <cashier:ModifierPanelView Grid.Column="0"
                                       Panel.ZIndex="10"
                                       DataContext="{Binding ModifierPanel}"/>
            <cashier:CartPanelView Grid.Column="1"/>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource Color.Surface.Default}"
                BorderBrush="{StaticResource Color.Border.Default}"
                BorderThickness="0,1,0,0"
                Padding="{StaticResource Spacing.CardInner}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource POS.Button.Cash}"
                        VerticalAlignment="Center"
                        Command="{Binding PayCashCommand}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{DynamicResource Common.Cash}"
                                   FontSize="{StaticResource Font.Size.Base}"
                                   FontWeight="{StaticResource Font.Weight.SemiBold}"
                                   TextAlignment="Center"/>
                        <controls:CurrencyText Amount="{Binding Total}"
                                               AmountForeground="{StaticResource Color.Text.OnBrand}"
                                               FontSize="{StaticResource Font.Size.Xl}"
                                               FontWeight="{StaticResource Font.Weight.Bold}"
                                               HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Style="{StaticResource POS.Button.Card}"
                        VerticalAlignment="Center"
                        Command="{Binding PayCardCommand}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{DynamicResource Common.Card}"
                                   FontSize="{StaticResource Font.Size.Base}"
                                   FontWeight="{StaticResource Font.Weight.SemiBold}"
                                   TextAlignment="Center"/>
                        <controls:CurrencyText Amount="{Binding Total}"
                                               AmountForeground="{StaticResource Color.Text.OnBrand}"
                                               FontSize="{StaticResource Font.Size.Xl}"
                                               FontWeight="{StaticResource Font.Weight.Bold}"
                                               HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- Left separator -->
                    <Border Width="1"
                            Height="24"
                            Background="{StaticResource Color.Border.Default}"
                            Margin="{StaticResource Spacing.Sm}"/>

                    <Button Style="{StaticResource POS.Button.Ghost}"
                            MinHeight="{StaticResource Size.TouchTarget.Min}"
                            Command="{Binding ReprintLastReceiptCommand}"
                            Margin="{StaticResource Spacing.HeaderActionGap}">
                        <TextBlock Text="{DynamicResource Cashier.ReprintLast}"
                                   FontSize="{StaticResource Font.Size.Sm}"
                                   FontWeight="{StaticResource Font.Weight.Medium}"
                                   TextAlignment="Center"/>
                    </Button>

                    <Button Style="{StaticResource POS.Button.Ghost}"
                            MinHeight="{StaticResource Size.TouchTarget.Min}"
                            Command="{Binding ShowRecentSalesCommand}">
                        <TextBlock Text="{DynamicResource Cashier.RecentSales}"
                                   FontSize="{StaticResource Font.Size.Sm}"
                                   FontWeight="{StaticResource Font.Weight.Medium}"
                                   TextAlignment="Center"/>
                    </Button>

                    <!-- Right separator -->
                    <Border Width="1"
                            Height="24"
                            Background="{StaticResource Color.Border.Default}"
                            Margin="{StaticResource Spacing.Sm}"/>

                </StackPanel>

                <Button Grid.Column="3"
                        Style="{StaticResource POS.Button.ClearSale}"
                        VerticalAlignment="Center"
                        Command="{Binding ClearSaleCommand}">
                    <TextBlock Text="{DynamicResource Cashier.ClearSale}"
                               FontSize="{StaticResource Font.Size.Base}"
                               FontWeight="{StaticResource Font.Weight.SemiBold}"
                               TextAlignment="Center"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
