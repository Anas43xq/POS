<UserControl x:Class="UI.Views.Cashier.CashierDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             xmlns:cashier="clr-namespace:UI.Views.Cashier"
             xmlns:b="clr-namespace:UI.Behaviors"
             mc:Ignorable="d"
             d:DesignWidth="1600" d:DesignHeight="900"
             b:ShortcutBindingsBehavior.Role="Cashier">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3"
                Background="{StaticResource Color.Surface.AppBackground}"/>

        <cashier:CashierHeaderView Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="288"/>
            </Grid.ColumnDefinitions>

            <cashier:ProductsPanelView Grid.Column="0"/>
            <cashier:ModifierPanelView Grid.Column="0"
                                       Panel.ZIndex="10"
                                       DataContext="{Binding ModifierPanel}"/>
            <cashier:CartPanelView Grid.Column="1"/>
        </Grid>

        <Border x:Name="FooterBar"
                Grid.Row="2"
                Background="{StaticResource Color.Surface.Default}"
                BorderBrush="{StaticResource Color.Border.Default}"
                BorderThickness="0,1,0,0"
                Padding="{StaticResource Spacing.CardInner}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource POS.Button.Cash}"
                        VerticalAlignment="Center"
                        Command="{Binding PayCashCommand}">
                    <Grid>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Common.Cash}"
                                           FontSize="{StaticResource Font.Size.Base}"
                                           FontWeight="{StaticResource Font.Weight.SemiBold}"
                                           TextAlignment="Center"/>
                                <TextBlock Text=" - "
                                           FontSize="{StaticResource Font.Size.Base}"
                                           FontWeight="{StaticResource Font.Weight.SemiBold}"
                                           TextAlignment="Center"/>
                                <controls:KeyHint Key="{Binding CashPaymentShortcut}"
                                                  BadgeStyle="OnBrand"
                                                  VerticalAlignment="Center"
                                                  Margin="{StaticResource Spacing.HeaderActionGap}"/>
                            </StackPanel>
                            <controls:CurrencyText Amount="{Binding Total}"
                                                    AmountForeground="{StaticResource Color.Text.OnBrand}"
                                                    FontSize="{StaticResource Font.Size.Xl}"
                                                    FontWeight="{StaticResource Font.Weight.Bold}"
                                                    Margin="{StaticResource Spacing.HeaderChipGap}"
                                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="1"
                        Style="{StaticResource POS.Button.Card}"
                        VerticalAlignment="Center"
                        Command="{Binding PayCardCommand}">
                    <Grid>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Common.Card}"
                                           FontSize="{StaticResource Font.Size.Base}"
                                           FontWeight="{StaticResource Font.Weight.SemiBold}"
                                           TextAlignment="Center"/>
                                <TextBlock Text=" - "
                                           FontSize="{StaticResource Font.Size.Base}"
                                           FontWeight="{StaticResource Font.Weight.SemiBold}"
                                           TextAlignment="Center"/>
                                <controls:KeyHint Key="{Binding CardPaymentShortcut}"
                                                  BadgeStyle="OnBrand"
                                                  VerticalAlignment="Center"
                                                  Margin="{StaticResource Spacing.HeaderActionGap}"/>
                            </StackPanel>
                            <controls:CurrencyText Amount="{Binding Total}"
                                                    AmountForeground="{StaticResource Color.Text.OnBrand}"
                                                    FontSize="{StaticResource Font.Size.Xl}"
                                                    FontWeight="{StaticResource Font.Weight.Bold}"
                                                    Margin="{StaticResource Spacing.HeaderChipGap}"
                                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- Left separator -->
                    <Border Width="1"
                            Height="24"
                            Background="{StaticResource Color.Border.Default}"
                            Margin="{StaticResource Spacing.Sm}"/>

                    <Button Style="{StaticResource POS.Button.Ghost}"
                            MinHeight="{StaticResource Size.TouchTarget.Min}"
                            Command="{Binding ReprintLastReceiptCommand}"
                            Margin="{StaticResource Spacing.HeaderActionGap}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Cashier.ReprintLast}"
                                       FontSize="{StaticResource Font.Size.Sm}"
                                       FontWeight="{StaticResource Font.Weight.Medium}"
                                       TextAlignment="Center"/>
                            <TextBlock Text=" - "
                                       FontSize="{StaticResource Font.Size.Sm}"
                                       FontWeight="{StaticResource Font.Weight.Medium}"
                                       TextAlignment="Center"/>
                            <controls:KeyHint Key="{Binding ReprintLastReceiptShortcut}"
                                              BadgeStyle="Default"
                                              VerticalAlignment="Center"
                                              Margin="{StaticResource Spacing.HeaderActionGap}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource POS.Button.Ghost}"
                            MinHeight="{StaticResource Size.TouchTarget.Min}"
                            Command="{Binding ShowRecentSalesCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Cashier.RecentSales}"
                                       FontSize="{StaticResource Font.Size.Sm}"
                                       FontWeight="{StaticResource Font.Weight.Medium}"
                                       TextAlignment="Center"/>
                            <TextBlock Text=" - "
                                       FontSize="{StaticResource Font.Size.Sm}"
                                       FontWeight="{StaticResource Font.Weight.Medium}"
                                       TextAlignment="Center"/>
                            <controls:KeyHint Key="{Binding ShowRecentSalesShortcut}"
                                              BadgeStyle="Default"
                                              VerticalAlignment="Center"
                                              Margin="{StaticResource Spacing.HeaderActionGap}"/>
                        </StackPanel>
                    </Button>

                    <!-- Right separator -->
                    <Border Width="1"
                            Height="24"
                            Background="{StaticResource Color.Border.Default}"
                            Margin="{StaticResource Spacing.Sm}"/>

                </StackPanel>

                <Button Grid.Column="3"
                        Style="{StaticResource POS.Button.ClearSale}"
                        VerticalAlignment="Center"
                        Command="{Binding ClearSaleCommand}">
                    <TextBlock Text="{DynamicResource Cashier.ClearSale}"
                               FontSize="{StaticResource Font.Size.Base}"
                               FontWeight="{StaticResource Font.Weight.SemiBold}"
                               TextAlignment="Center"/>
                </Button>
            </Grid>
        </Border>
        <!-- Language picker popup — floats above the footer, anchored to FooterBar -->
        <Popup x:Name="LanguagePickerPopup"
               Grid.Row="2"
               PlacementTarget="{Binding ElementName=FooterBar}"
               Placement="Top"
               VerticalOffset="-8"
               StaysOpen="False"
               IsOpen="{Binding IsLanguagePickerOpen, Mode=TwoWay}"
               AllowsTransparency="True"
               PopupAnimation="Fade">

            <Border Background="{StaticResource Color.Surface.Default}"
                    BorderBrush="{StaticResource Color.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Md}"
                    Padding="{StaticResource Spacing.CardBody}"
                    Effect="{StaticResource Shadow.Lg}">

                <StackPanel Orientation="Vertical">

                    <!-- Header row -->
                    <StackPanel Orientation="Horizontal"
                                Margin="{StaticResource Spacing.DialogLabelGap}">
                        <TextBlock Text="Language"
                                   FontSize="{StaticResource Font.Size.Sm}"
                                   FontWeight="{StaticResource Font.Weight.SemiBold}"
                                   Foreground="{StaticResource Color.Text.Muted}"/>
                        <controls:KeyHint Key="Ctrl+L"
                                          BadgeStyle="Default"
                                          VerticalAlignment="Center"
                                          Margin="{StaticResource Spacing.HeaderActionGap}"/>
                    </StackPanel>

                    <!-- Language buttons — one per supported language -->
                    <ItemsControl x:Name="LanguageItemsControl"
                                  ItemsSource="{Binding SupportedLanguages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource POS.Button.Ghost}"
                                        MinHeight="{StaticResource Size.TouchTarget.Min}"
                                        Command="{Binding DataContext.SelectLanguageCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="{StaticResource Font.Size.Md}"
                                               FontWeight="{StaticResource Font.Weight.Medium}"
                                               Foreground="{StaticResource Color.Text.Default}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </Popup>
    </Grid>
</UserControl>
