<UserControl x:Class="UI.Views.Cashier.QuickActionsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="100" d:DesignHeight="900">

    <Border Background="{StaticResource Color.Surface.Default}"
            BorderBrush="{StaticResource Color.Border.Default}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Default}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource Color.Surface.Subtle}"
                    BorderBrush="{StaticResource Color.Border.Default}"
                    BorderThickness="0,0,0,1"
                    Padding="{StaticResource Spacing.Xs2}">
                <TextBlock Text="{DynamicResource Cashier.QuickActions}"
                           FontSize="{StaticResource Font.Size.Base}"
                           FontWeight="{StaticResource Font.Weight.SemiBold}"
                           Foreground="{StaticResource Color.Text.Default}"/>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="{StaticResource Spacing.Xs2}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Cashier.Sale}"
                               FontSize="{StaticResource Font.Size.Xs}"
                               FontWeight="{StaticResource Font.Weight.Medium}"
                               Foreground="{StaticResource Color.Text.Muted}"
                               Margin="{StaticResource Spacing.Xs}"/>

                    <Button Style="{StaticResource POS.Button.Primary}"
                            MinHeight="{StaticResource Size.TouchTarget.Min}"
                            Command="{Binding ShowRecentSalesCommand}">
                        <TextBlock Text="{DynamicResource Cashier.RecentSales}"
                                   FontSize="{StaticResource Font.Size.Sm}"
                                   FontWeight="{StaticResource Font.Weight.SemiBold}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
