<UserControl x:Class="UI.Views.Cashier.ModifierPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             xmlns:vm="clr-namespace:UI.ViewModels.Modifiers"
             mc:Ignorable="d"
             d:DesignWidth="380" d:DesignHeight="900">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:SingleSelectGroupViewModel}">
            <StackPanel Margin="{StaticResource Spacing.DialogSectionGap}">
                <StackPanel Orientation="Horizontal"
                            Margin="{StaticResource Spacing.DialogTitleGap}">
                    <TextBlock Text="{Binding Name}"
                               FontSize="{StaticResource Font.Size.Base}"
                               FontWeight="{StaticResource Font.Weight.Bold}"
                               Foreground="{StaticResource Color.Text.Default}"
                               Margin="{StaticResource Spacing.HeaderActionGap}"/>
                    <Border Background="{StaticResource Color.Danger.Default}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{StaticResource Spacing.Xxs}"
                            Visibility="{Binding IsRequired, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Cashier.Required}"
                                   FontSize="{StaticResource Font.Size.Xs}"
                                   FontWeight="{StaticResource Font.Weight.Bold}"
                                   Foreground="{StaticResource Color.Text.OnBrand}"/>
                    </Border>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource POS.ToggleButton.Default}"
                                          MinHeight="{StaticResource Size.TouchTarget.Min}"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Command="{Binding SelectCommand}">
                                <WrapPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource Font.Size.Base}"
                                               FontWeight="{StaticResource Font.Weight.Medium}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding PriceAddDisplay}"
                                               FontSize="{StaticResource Font.Size.Caption}"
                                               Margin="{StaticResource Spacing.HeaderActionGap}"
                                               Visibility="{Binding HasPriceAdd, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </WrapPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MultiSelectGroupViewModel}">
            <StackPanel Margin="{StaticResource Spacing.DialogSectionGap}">
                <StackPanel Orientation="Horizontal"
                            Margin="{StaticResource Spacing.DialogTitleGap}">
                    <TextBlock Text="{Binding Name}"
                               FontSize="{StaticResource Font.Size.Base}"
                               FontWeight="{StaticResource Font.Weight.Bold}"
                               Foreground="{StaticResource Color.Text.Default}"
                               Margin="{StaticResource Spacing.HeaderActionGap}"/>
                    <Border Background="{StaticResource Color.Danger.Default}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{StaticResource Spacing.Xxs}"
                            Visibility="{Binding IsRequired, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Cashier.Required}"
                                   FontSize="{StaticResource Font.Size.Xs}"
                                   FontWeight="{StaticResource Font.Weight.Bold}"
                                   Foreground="{StaticResource Color.Text.OnBrand}"/>
                    </Border>
                    <TextBlock Text="{Binding SelectionHint}"
                               FontSize="{StaticResource Font.Size.Caption}"
                               Foreground="{StaticResource Color.Text.Secondary}"
                               Margin="{StaticResource Spacing.RowSectionGap}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource POS.ToggleButton.Default}"
                                          MinHeight="{StaticResource Size.TouchTarget.Min}"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Command="{Binding SelectCommand}">
                                <WrapPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource Font.Size.Base}"
                                               FontWeight="{StaticResource Font.Weight.Medium}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding PriceAddDisplay}"
                                               FontSize="{StaticResource Font.Size.Caption}"
                                               Margin="{StaticResource Spacing.HeaderActionGap}"
                                               Visibility="{Binding HasPriceAdd, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </WrapPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:QuantityGroupViewModel}">
            <StackPanel Margin="{StaticResource Spacing.DialogSectionGap}">
                <TextBlock Text="{Binding Name}"
                           FontSize="{StaticResource Font.Size.Base}"
                           FontWeight="{StaticResource Font.Weight.Bold}"
                           Foreground="{StaticResource Color.Text.Default}"
                           Margin="{StaticResource Spacing.DialogTitleGap}"/>
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Color.Border.Brand}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Padding="{StaticResource Spacing.RoleRowPadding}"
                                    Margin="{StaticResource Spacing.Xs}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{StaticResource Font.Size.Base}"
                                                   FontWeight="{StaticResource Font.Weight.Medium}"
                                                   Foreground="{StaticResource Color.Text.Default}"/>
                                        <controls:CurrencyText Amount="{Binding UnitPrice}"
                                                               AmountForeground="{StaticResource Color.Text.Muted}"
                                                               FontSize="{StaticResource Font.Size.Caption}"
                                                               FontWeight="{StaticResource Font.Weight.Medium}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource POS.Button.Ghost}"
                                                MinHeight="{StaticResource Size.TouchTarget.Min}"
                                                Width="{StaticResource Size.TouchTarget.Min}"
                                                Command="{Binding DecrementCommand}">
                                            <TextBlock Text="-"
                                                       FontSize="{StaticResource Font.Size.Lg}"
                                                       FontWeight="{StaticResource Font.Weight.Bold}"
                                                       TextAlignment="Center"/>
                                        </Button>
                                        <TextBlock Text="{Binding Quantity}"
                                                   Width="{StaticResource Size.Icon.Default}"
                                                   FontSize="{StaticResource Font.Size.Base}"
                                                   FontWeight="{StaticResource Font.Weight.Bold}"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource POS.Button.Ghost}"
                                                MinHeight="{StaticResource Size.TouchTarget.Min}"
                                                Width="{StaticResource Size.TouchTarget.Min}"
                                                Command="{Binding IncrementCommand}">
                                            <TextBlock Text="+"
                                                       FontSize="{StaticResource Font.Size.Lg}"
                                                       FontWeight="{StaticResource Font.Weight.Bold}"
                                                       TextAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Visibility="{Binding IsModifierPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
        <Border Background="{StaticResource Color.Brand.Scrim}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick"
                              Command="{Binding CloseModifierPanelCommand}"/>
            </Border.InputBindings>
        </Border>

        <Border HorizontalAlignment="Right"
                Width="380"
                Background="{StaticResource Color.Surface.Default}"
                BorderBrush="{StaticResource Color.Border.Default}"
                BorderThickness="1,0,0,0"
                CornerRadius="{StaticResource Radius.Md}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource POS.Dialog.Header}"
                        Padding="{StaticResource Spacing.RoleRowPadding}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedProductForModifier.DisplayName}"
                                       FontSize="{StaticResource Font.Size.Lg}"
                                       FontWeight="{StaticResource Font.Weight.Bold}"
                                       Foreground="{StaticResource Color.Text.Default}"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="{StaticResource Spacing.Xxs}">
                                <TextBlock FontSize="{StaticResource Font.Size.Sm}"
                                           Foreground="{StaticResource Color.Text.Secondary}">
                                    <Run Text="{DynamicResource Cashier.Base}"/>
                                    <Run Text=" "/>
                                </TextBlock>
                                <controls:CurrencyText Amount="{Binding SelectedProductForModifier.UnitPrice}"
                                                       AmountForeground="{StaticResource Color.Text.Secondary}"
                                                       FontSize="{StaticResource Font.Size.Sm}"
                                                       FontWeight="{StaticResource Font.Weight.Medium}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource POS.Dialog.CloseButton}"
                                Content="x"
                                Command="{Binding CloseModifierPanelCommand}"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="{StaticResource Spacing.RoleRowPadding}">
                    <ItemsControl ItemsSource="{Binding ModifierGroups}"/>
                </ScrollViewer>

                <StackPanel Grid.Row="2"
                            Margin="{StaticResource Spacing.DialogFooter}">
                    <Button Style="{StaticResource POS.Button.Primary}"
                            IsEnabled="{Binding AllRequiredGroupsSatisfied}"
                            Command="{Binding ConfirmModifierCommand}">
                        <Grid Width="340">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ModifierConfirmLabel}"
                                       Foreground="{StaticResource Color.Text.OnBrand}"
                                       VerticalAlignment="Center"/>
                            <controls:CurrencyText Grid.Column="1"
                                                   Amount="{Binding ModifierRunningTotal}"
                                                   AmountForeground="{StaticResource Color.Text.OnBrand}"
                                                   FontWeight="{StaticResource Font.Weight.Bold}"
                                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <TextBlock Text="{DynamicResource Cashier.SelectRequired}"
                               FontSize="{StaticResource Font.Size.Caption}"
                               Foreground="{StaticResource Color.Danger.Default}"
                               TextAlignment="Center"
                               Margin="{StaticResource Spacing.DialogLabelGap}"
                               Visibility="{Binding AllRequiredGroupsSatisfied, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
