<!--
    ╔══════════════════════════════════════════════════════╗
    ║   Cafeteria Hawa POS  –  Manager Main Shell          ║
    ║   Header + Navy Sidebar + Content Frame              ║
    ╚══════════════════════════════════════════════════════╝
-->
<UserControl x:Class="UI.Views.ManagerMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:UI.ViewModels"
             xmlns:views="clr-namespace:UI.Views"
             xmlns:modifiers="clr-namespace:UI.Views.Modifiers"
             xmlns:b="clr-namespace:UI.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600"
             b:ShortcutBindingsBehavior.Role="Manager">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TransactionsViewModel}">
            <views:TransactionsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ShiftManagementViewModel}">
            <views:ShiftManagementView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProductManagementViewModel}">
            <views:ProductManagementView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CategoryManagementViewModel}">
            <views:CategoryManagementView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SizeManagementViewModel}">
            <views:SizeManagementView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReceiptManagementViewModel}">
            <views:ReceiptManagementView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ModifierGroupManagementViewModel}">
            <modifiers:ModifierGroupManagementView />
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{StaticResource Color.Brand.Light}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <!-- Header  -->
            <RowDefinition Height="*"/>
            <!-- Body    -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════
             ROW 0 · HEADER
             ══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Style="{StaticResource POS.Manager.HeaderBorder}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Logo+title    -->
                    <ColumnDefinition Width="*"/>
                    <!-- Manager name  -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Date/time     -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Settings      -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Logout        -->
                </Grid.ColumnDefinitions>

                <!-- Logo + brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="{StaticResource Spacing.HeaderBrandMargin}">
                    <Border Width="30" Height="30" CornerRadius="{StaticResource Radius.Md}" Margin="{StaticResource Spacing.HeaderLogoMargin}"
                            Background="{StaticResource POS.Manager.LogoBadgeGradient}">
                        <!-- Brand logo image (existing asset) — replaces the old emoji stand-in -->
                        <Image Source="pack://application:,,,/UI;component/Assets/logo.png"
                               Width="18" Height="18"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Login.Brand}"
                               FontSize="{StaticResource Font.Size.Lg}"
                               FontWeight="{StaticResource Font.Weight.Medium}"
                               Foreground="{StaticResource Color.Text.Default}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Manager name -->
                <TextBlock Grid.Column="1"
                           Text="{Binding ManagerName, FallbackValue='Sarah (Manager)'}"
                           FontSize="{StaticResource Font.Size.Base}"
                           FontWeight="{StaticResource Font.Weight.Medium}"
                           Foreground="{StaticResource Color.Text.Default}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Spacing.HeaderNameMargin}"/>

                <!-- Date/time -->
                <TextBlock Grid.Column="2"
                           Text="{Binding CurrentDateTime}"
                           FontSize="{StaticResource Font.Size.Sm}"
                           Foreground="{StaticResource Color.Text.Muted}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Spacing.HeaderNameMargin}"/>

                <!-- Settings (gear icon) — mirrors the cashier header -->
                <Button Grid.Column="3"
                        Style="{StaticResource POS.Button.Secondary}"
                        Margin="{StaticResource Spacing.HeaderActionGap}"
                        Command="{Binding ShowSetting}"
                        ToolTip="{DynamicResource Settings.Title}">
                    <!-- Settings gear (placeholder asset — swap Assets/nav/settings_dark.png when a final icon is ready) -->
                    <Image Source="pack://application:,,,/UI;component/Assets/nav/settings_dark.png"
                           Width="14" Height="14"
                           Stretch="Uniform"
                           VerticalAlignment="Center"/>
                </Button>

                <!-- Logout -->
                <Button Grid.Column="4"
                        Style="{StaticResource POS.Button.Danger}"
                        Command="{Binding LogoutCommand}">
                    <TextBlock>
                        <Run Text="⎋  "/>
                        <Run Text="{DynamicResource Common.Logout}"/>
                    </TextBlock>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════
             ROW 1 · BODY (Sidebar + Content)
             ══════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────────
                 SIDEBAR
                 ───────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource POS.Manager.SidebarGradient}">

                <StackPanel Margin="{StaticResource Spacing.2}">

                    <TextBlock Text="{DynamicResource Manager.Nav.Menu}" Style="{StaticResource POS.Manager.SidebarSectionLabel}"/>

                    <RadioButton Style="{StaticResource POS.Manager.NavItem}"
                                 IsChecked="True"
                                 Command="{Binding NavigateHomeCommand}">
                        <RadioButton.Tag>
                            <Image Source="pack://application:,,,/UI;component/Assets/nav/home.png" Style="{StaticResource POS.Manager.NavIconImage}"/>
                        </RadioButton.Tag>
                        <TextBlock Text="{DynamicResource Manager.Nav.Home}" Style="{StaticResource POS.Manager.NavLabel}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource POS.Manager.NavItem}"
                                 Command="{Binding NavigateTransactionsCommand}">
                        <RadioButton.Tag>
                            <Image Source="pack://application:,,,/UI;component/Assets/nav/transactions.png" Style="{StaticResource POS.Manager.NavIconImage}"/>
                        </RadioButton.Tag>
                        <TextBlock Text="{DynamicResource Manager.Nav.Transactions}" Style="{StaticResource POS.Manager.NavLabel}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource POS.Manager.NavItem}"
                                 Command="{Binding NavigateShiftManagementCommand}">
                        <RadioButton.Tag>
                            <Image Source="pack://application:,,,/UI;component/Assets/nav/shift.png" Style="{StaticResource POS.Manager.NavIconImage}"/>
                        </RadioButton.Tag>
                        <TextBlock Text="{DynamicResource Manager.Nav.ShiftManagement}" Style="{StaticResource POS.Manager.NavLabel}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource POS.Manager.NavItem}"
                                 Command="{Binding NavigateReportsCommand}">
                        <RadioButton.Tag>
                            <Image Source="pack://application:,,,/UI;component/Assets/nav/reports.png" Style="{StaticResource POS.Manager.NavIconImage}"/>
                        </RadioButton.Tag>
                        <TextBlock Text="{DynamicResource Manager.Nav.Reports}" Style="{StaticResource POS.Manager.NavLabel}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource POS.Manager.NavItem}"
                                 Command="{Binding NavigateProductManagementCommand}">
                        <RadioButton.Tag>
                            <Image Source="pack://application:,,,/UI;component/Assets/nav/products.png" Style="{StaticResource POS.Manager.NavIconImage}"/>
                        </RadioButton.Tag>
                        <TextBlock Text="{DynamicResource Manager.Nav.Products}" Style="{StaticResource POS.Manager.NavLabel}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource POS.Manager.NavItem}"
                                 Command="{Binding NavigateCategoryManagementCommand}">
                        <RadioButton.Tag>
                            <Image Source="pack://application:,,,/UI;component/Assets/nav/categories.png" Style="{StaticResource POS.Manager.NavIconImage}"/>
                        </RadioButton.Tag>
                        <TextBlock Text="{DynamicResource Manager.Nav.Categories}" Style="{StaticResource POS.Manager.NavLabel}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource POS.Manager.NavItem}"
                                 Command="{Binding NavigateSizeManagementCommand}">
                        <RadioButton.Tag>
                            <Image Source="pack://application:,,,/UI;component/Assets/nav/sizes.png" Style="{StaticResource POS.Manager.NavIconImage}"/>
                        </RadioButton.Tag>
                        <TextBlock Text="{DynamicResource Manager.Nav.Sizes}" Style="{StaticResource POS.Manager.NavLabel}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource POS.Manager.NavItem}"
                                 Command="{Binding NavigateReceiptManagementCommand}">
                        <RadioButton.Tag>
                            <Image Source="pack://application:,,,/UI;component/Assets/nav/receipts.png" Style="{StaticResource POS.Manager.NavIconImage}"/>
                        </RadioButton.Tag>
                        <TextBlock Text="{DynamicResource Manager.Nav.ReceiptManagement}" Style="{StaticResource POS.Manager.NavLabel}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource POS.Manager.NavItem}"
                                 Command="{Binding NavigateModifierGroupManagementCommand}">
                        <RadioButton.Tag>
                            <Image Source="pack://application:,,,/UI;component/Assets/nav/modifiers.png" Style="{StaticResource POS.Manager.NavIconImage}"/>
                        </RadioButton.Tag>
                        <TextBlock Text="{DynamicResource Manager.Nav.ModifierGroups}" Style="{StaticResource POS.Manager.NavLabel}"/>
                    </RadioButton>

                </StackPanel>
            </Border>

            <!-- ─────────────────────────────────
                 CONTENT FRAME
                 Hosts HomeView / TransactionsView / etc.
                 via Frame or ContentControl bound to
                 the active ViewModel.
                 ───────────────────────────────── -->
             <Border Grid.Column="1" Background="{StaticResource Color.Brand.Light}">
                <ContentControl Content="{Binding CurrentPage}" Margin="{StaticResource Spacing.Md}"/>
            </Border>

        </Grid>
    </Grid>
</UserControl>
