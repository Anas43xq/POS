<!--
    ╔══════════════════════════════════════════════════════╗
    ║   Key Metrics — full-width strip, 5 equal tiles.      ║
    ║   Priority #1 in the dashboard hierarchy: large       ║
    ║   numbers, compact cards, readable at a glance.        ║
    ╚══════════════════════════════════════════════════════╝
-->
<UserControl x:Class="UI.Views.KpiMetricsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             mc:Ignorable="d" d:DesignHeight="110" d:DesignWidth="1225">

    <Border Style="{StaticResource CardBorder}">
        <StackPanel>
            <Border Style="{StaticResource CardHeaderBorder}">
                <TextBlock Style="{StaticResource CardTitle}">
                    <Run Text="📈"/>
                    <Run Text="  "/>
                    <Run Text="{DynamicResource Manager.Home.KeyMetrics}"/>
                </TextBlock>
            </Border>

            <UniformGrid Columns="5" Margin="{StaticResource Spacing.3}">
                <Border Style="{StaticResource DashboardKpiTile}" Margin="{StaticResource Spacing.1}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Manager.Home.KpiTotalSales}" Style="{StaticResource DashboardKpiLabel}"/>
                        <controls:CurrencyText Amount="{Binding TotalSales}" Style="{StaticResource DashboardKpiValueCurrency}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardKpiTile}" Margin="{StaticResource Spacing.1}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Manager.Home.KpiAverageSale}" Style="{StaticResource DashboardKpiLabel}"/>
                        <controls:CurrencyText Amount="{Binding AverageSales}" Style="{StaticResource DashboardKpiValueCurrency}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardKpiTile}" Margin="{StaticResource Spacing.1}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Manager.Home.KpiTotalCash}" Style="{StaticResource DashboardKpiLabel}"/>
                        <controls:CurrencyText Amount="{Binding TotalCash}" Style="{StaticResource DashboardKpiValueCurrency}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardKpiTile}" Margin="{StaticResource Spacing.1}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Manager.Home.KpiTotalCard}" Style="{StaticResource DashboardKpiLabel}"/>
                        <controls:CurrencyText Amount="{Binding TotalCard}" Style="{StaticResource DashboardKpiValueCurrency}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardKpiTile}" Margin="{StaticResource Spacing.1}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Manager.Home.KpiTotalOrders}" Style="{StaticResource DashboardKpiLabel}"/>
                        <TextBlock Text="{Binding TotalOrders}"
                                   Style="{StaticResource DashboardKpiValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
