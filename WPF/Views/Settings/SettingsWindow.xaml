<Window x:Class="UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:settings="clr-namespace:UI.Views"
        mc:Ignorable="d"
        Title="{DynamicResource Settings.Title}"
        Width="560" Height="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Style="{StaticResource POS.Window.Overlay}">

    <Grid x:Name="OverlayGrid"
          Background="{StaticResource Color.Brand.Scrim}"
          MouseDown="OverlayGrid_MouseDown">

        <Border x:Name="DialogCard"
                Width="520"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Style="{StaticResource POS.Dialog.Card}"
                MouseDown="DialogCard_MouseDown">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header  -->
                    <RowDefinition Height="*"/>
                    <!-- Body    -->
                    <RowDefinition Height="Auto"/>
                    <!-- Footer  -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Style="{StaticResource POS.Dialog.Header}"
                        Padding="{StaticResource Spacing.DialogHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource Radius.Md}"
                                    Background="{StaticResource Color.Brand.Dark}"
                                    Margin="{StaticResource Spacing.Settings.InlineButtonGap}">
                                <TextBlock Text="⚙"
                                           FontSize="{StaticResource Font.Size.Lg}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Settings.Title}"
                                       FontSize="{StaticResource Font.Size.Lg}"
                                       FontWeight="{StaticResource Font.Weight.SemiBold}"
                                       Foreground="{StaticResource Color.Text.Primary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="✕"
                                FontSize="{StaticResource Font.Size.Md}"
                                Style="{StaticResource POS.Dialog.CloseButton}"
                                Command="{Binding CloseCommand}"/>
                    </Grid>
                </Border>

                <!-- Body -->
                <settings:SettingsView Grid.Row="1" DataContext="{Binding}"/>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Style="{StaticResource POS.Dialog.Footer}"
                        Padding="{StaticResource Spacing.DialogFooter}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource POS.Button.Secondary}"
                                Content="{DynamicResource Common.Cancel}"
                                Margin="{StaticResource Spacing.DialogFooterCancelGap}"
                                Command="{Binding CloseCommand}"/>
                        <Button Style="{StaticResource POS.Button.Primary}"
                                Content="{DynamicResource Common.Save}"
                                Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
