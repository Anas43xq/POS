<UserControl x:Class="UI.Views.SizeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="820"
             Background="{StaticResource Color.Brand.Light}">

    <Grid Margin="{StaticResource Spacing.4}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource Spacing.3}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{DynamicResource Sizes.Title}"
                       FontSize="{StaticResource Font.Size.Lg}"
                       FontWeight="{StaticResource Font.Weight.Medium}"
                       Foreground="{StaticResource Color.Text.Default}"
                       VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource Color.Surface.Default}"
                BorderBrush="{StaticResource Color.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Lg}"
                Padding="{StaticResource Spacing.3}"
                Margin="{StaticResource Spacing.3}">
            <controls:CrudActionButtons
                AddCommand="{Binding AddCommand}"
                AddLabel="{DynamicResource Common.Add}"
                EditCommand="{Binding EditCommand}"
                EditEnabled="{Binding HasSelection}"
                EditLabel="{DynamicResource Common.Edit}"
                DeleteCommand="{Binding DeleteCommand}"
                DeleteEnabled="{Binding HasSelection}"
                DeleteLabel="{DynamicResource Common.Delete}"
                ShowTranslations="True"
                TranslationsCommand="{Binding TranslationsCommand}"
                TranslationsEnabled="{Binding HasSelection}"
                TranslationsLabel="{DynamicResource Common.Translations}"
                RefreshCommand="{Binding RefreshCommand}"
                RefreshLabel="{DynamicResource Common.Refresh}"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Color.Surface.Default}"
                    BorderBrush="{StaticResource Color.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}"
                    Padding="{StaticResource Spacing.3}">
                    <DataGrid Style="{StaticResource POS.DataGrid.Default}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ItemsSource="{Binding Sizes}"
                          SelectedItem="{Binding SelectedSize, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Sizes.ColName}" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="{DynamicResource Sizes.ColDisplayOrder}" Binding="{Binding DisplayOrder}" Width="1*"/>
                        <DataGridTextColumn Header="{DynamicResource Sizes.ColActive}" Binding="{Binding Status}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource Color.Surface.Default}"
                    BorderBrush="{StaticResource Color.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Lg}"
                    Padding="{StaticResource Spacing.4}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Sizes.DetailsTitle}"
                               FontSize="{StaticResource Font.Size.Base}"
                               FontWeight="{StaticResource Font.Weight.Medium}"
                               Foreground="{StaticResource Color.Text.Default}"
                               Margin="{StaticResource Spacing.3}"/>

                    <Border Style="{StaticResource POS.Dialog.NoticeDanger}"
                            Margin="{StaticResource Spacing.DialogErrorBannerMargin}"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource POS.Dialog.ErrorText}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="{DynamicResource Sizes.FieldName}"
                               FontSize="{StaticResource Font.Size.Sm}"
                               FontWeight="{StaticResource Font.Weight.Medium}"
                               Foreground="{StaticResource Color.Text.Muted}"
                               Margin="{StaticResource Spacing.1}"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource POS.TextBox.Default}"
                             Margin="{StaticResource Spacing.3}"/>

                    <TextBlock Text="{DynamicResource Sizes.FieldDisplayOrder}"
                               FontSize="{StaticResource Font.Size.Sm}"
                               FontWeight="{StaticResource Font.Weight.Medium}"
                               Foreground="{StaticResource Color.Text.Muted}"
                               Margin="{StaticResource Spacing.1}"/>
                    <TextBox Text="{Binding EditDisplayOrder, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource POS.TextBox.Default}"
                             Margin="{StaticResource Spacing.3}"/>

                    <CheckBox Content="{DynamicResource Sizes.IsActive}"
                              IsChecked="{Binding EditIsActive}"
                              Style="{StaticResource POS.CheckBox.Default}"
                              Margin="{StaticResource Spacing.4}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource POS.Button.Secondary}"
                                Content="{DynamicResource Common.Cancel}"
                                Margin="{StaticResource Spacing.2}"
                                Command="{Binding CancelEditCommand}"/>
                        <Button Style="{StaticResource POS.Button.Primary}"
                                Content="{DynamicResource Common.Save}"
                                Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
