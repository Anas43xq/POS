<!--
    ╔══════════════════════════════════════════════════════╗
    ║   Cafeteria Hawa POS  –  Manager · Shift Management  ║
    ║   Filter bar + ManagerDataGrid + pagination          ║
    ║                                                       ║
    ║   The filter bar lives in its own UserControl         ║
    ║   (<views:ShiftFilterPanelControl/>). The grid reuses  ║
    ║   the same chrome as the Transactions page so the     ║
    ║   two list screens stay visually consistent.          ║
    ╚══════════════════════════════════════════════════════╝
-->
<UserControl x:Class="UI.Views.ShiftManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             xmlns:views="clr-namespace:UI.Views"
             mc:Ignorable="d"
             d:DesignWidth="1420" d:DesignHeight="820">

    <Grid Background="{StaticResource Color.Brand.Light}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Filter bar -->
            <RowDefinition Height="*"/>
            <!-- Table card -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════
             FILTER BAR
             ══════════════════════════════════════ -->
        <views:ShiftFilterPanelControl Grid.Row="0"/>

        <!-- ══════════════════════════════════════
             SHIFTS TABLE CARD
             ══════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- header -->
                    <RowDefinition Height="*"/>
                    <!-- grid   -->
                    <RowDefinition Height="Auto"/>
                    <!-- pager  -->
                </Grid.RowDefinitions>

                <!-- Card header -->
                <Border Grid.Row="0" Style="{StaticResource CardHeaderBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Manager.Shifts.CardTitle}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource Manager.Shifts.Loading}"
                                   FontSize="{StaticResource Font.Size.Sm}"
                                   Foreground="{StaticResource Color.Text.Muted}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- Shifts DataGrid. No SelectedItem binding — the host
                     ViewModel does not expose a SelectedShift property,
                     and Shift ID is opened via the per-row button. -->
                <DataGrid x:Name="ShiftsGrid"
                          Grid.Row="1"
                          Style="{StaticResource POS.DataGrid.Default}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ItemsSource="{Binding ShiftsView}">
                    <DataGrid.Columns>

                        <!-- Shift ID — clickable button (opens ShiftDetailView) -->
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Shifts.ColShiftId}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ShiftId}"
                                            FontSize="{StaticResource Font.Size.Sm}"
                                            FontWeight="{StaticResource Font.Weight.Medium}"
                                            Cursor="Hand"
                                            HorizontalAlignment="Left"
                                            MinHeight="{StaticResource Size.TouchTarget.Min}"
                                            Command="{Binding DataContext.OpenShiftDetailCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg"
                                                        Background="{StaticResource Color.Brand.Light}"
                                                        CornerRadius="{StaticResource Radius.Default}"
                                                        Padding="{StaticResource Spacing.2}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cashier -->
                        <DataGridTextColumn Header="{DynamicResource Manager.Shifts.ColCashier}"
                                            Binding="{Binding CashierName}" Width="140"/>

                        <!-- Opened At -->
                        <DataGridTextColumn Header="{DynamicResource Manager.Shifts.ColOpenedAt}"
                                            Binding="{Binding OpenedAt, StringFormat='yyyy-MM-dd HH:mm'}"
                                            Width="150"/>

                        <!-- Closed At -->
                        <DataGridTextColumn Header="{DynamicResource Manager.Shifts.ColClosedAt}"
                                            Binding="{Binding ClosedAt, StringFormat='yyyy-MM-dd HH:mm'}"
                                            Width="150"/>

                        <!-- Opening Cash (right-aligned) -->
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Shifts.ColOpening}" Width="120">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource POS.DataGrid.ColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CurrencyText Amount="{Binding OpeningCash}"
                                                           Style="{StaticResource POS.CurrencyText.Muted}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Closing Cash (right-aligned) -->
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Shifts.ColClosing}" Width="120">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource POS.DataGrid.ColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CurrencyText Amount="{Binding ClosingCash}"
                                                           Style="{StaticResource POS.CurrencyText.Muted}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Expected Cash (right-aligned) -->
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Shifts.ColExpected}" Width="120">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource POS.DataGrid.ColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CurrencyText Amount="{Binding ExpectedCash}"
                                                           Style="{StaticResource POS.CurrencyText.Muted}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Difference (right-aligned) — color via ShiftDifferenceCellStyle -->
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Shifts.ColDifference}" Width="120">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource POS.DataGrid.ColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CurrencyText Amount="{Binding CashDifference}"
                                                           Style="{StaticResource POS.Dialog.KpiValueDifference}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status badge -->
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Shifts.ColStatus}" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Tag="{Binding StatusLabel}"
                                            Style="{StaticResource POS.Badge.ShiftStatus}">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   Style="{StaticResource POS.Badge.ShiftStatusText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Duration -->
                        <DataGridTextColumn Header="{DynamicResource Manager.Shifts.ColDuration}"
                                            Binding="{Binding DurationHours, StringFormat={}{0:F1}h}"
                                            Width="90"/>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination footer -->
                <Border Grid.Row="2"
                        Background="{StaticResource Color.Surface.Subtle}"
                        BorderBrush="{StaticResource Color.Border.Default}"
                        BorderThickness="0,0.5,0,0"
                        Padding="{StaticResource Spacing.3}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="{StaticResource Font.Size.Sm}" Foreground="{StaticResource Color.Text.Muted}">
                                <Run Text="{DynamicResource Common.Page}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding PageInfo, Mode=OneWay}"/>
                                <Run Text="  ·  "/>
                                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                                <Run Text=" "/>
                                <Run Text="{DynamicResource Manager.Shifts.PagerSuffix}"/>
                            </TextBlock>
                            <!-- Error banner -->
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="{StaticResource Font.Size.Sm}" Foreground="{StaticResource Color.Danger.Default}"
                                       Margin="{StaticResource Spacing.1}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource POS.Button.Secondary}"
                                    Content="{DynamicResource Common.Previous}"
                                    Margin="{StaticResource Spacing.2}"
                                    Command="{Binding PreviousPageCommand}"/>
                            <Button Style="{StaticResource POS.Button.Primary}"
                                    Content="{DynamicResource Common.Next}"
                                    Command="{Binding NextPageCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
