<UserControl x:Class="UI.Views.RecentTransactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:UI.Controls"
             mc:Ignorable="d">

    <Grid Background="{StaticResource Color.Brand.Scrim}">
        <Border Width="720"
                MaxHeight="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource POS.Dialog.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource POS.Dialog.Header}"
                        Padding="{StaticResource Spacing.DialogHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Cashier.RecentSales}"
                                       FontSize="{StaticResource Font.Size.Lg}"
                                       FontWeight="{StaticResource Font.Weight.SemiBold}"
                                       Foreground="{StaticResource Color.Text.Default}"/>
                            <TextBlock Text="{DynamicResource RecentSales.Subtitle}"
                                       FontSize="{StaticResource Font.Size.Sm}"
                                       Foreground="{StaticResource Color.Text.Muted}"
                                       Margin="{StaticResource Spacing.Xxs}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource POS.Dialog.CloseButton}"
                                Command="{Binding CloseRecentSalesCommand}"
                                Content="{DynamicResource Common.Close}"/>
                    </Grid>
                </Border>

                <controls:RecentSalesList Grid.Row="1"
                                          ItemsSource="{Binding CashierDashboardViewModel.RecentSales}"
                                          OpenCommand="{Binding DataContext.OpenRecentSaleReceiptCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"/>

                <Border Grid.Row="2"
                        Style="{StaticResource POS.Dialog.Footer}"
                        Padding="{StaticResource Spacing.DialogFooter}">
                    <TextBlock Text="{DynamicResource RecentSales.FooterHint}"
                               Foreground="{StaticResource Color.Text.Muted}"
                               FontSize="{StaticResource Font.Size.Sm}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
