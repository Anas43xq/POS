<Window x:Class="UI.Views.RecentSalesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:UI.Controls"
        mc:Ignorable="d"
        Title="{DynamicResource RecentSales.Title}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Grid Background="{StaticResource Color.Brand.Scrim}">
        <Border Width="720"
                MaxHeight="640"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Style="{StaticResource POS.Dialog.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource POS.Dialog.Header}"
                        Padding="{StaticResource Spacing.DialogHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource RecentSales.Title}"
                                       FontSize="{StaticResource Font.Size.Lg}"
                                       FontWeight="{StaticResource Font.Weight.SemiBold}"
                                       Foreground="{StaticResource Color.Text.Default}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource POS.Dialog.CloseButton}"
                                Command="{Binding CloseDialogCommand}"
                                Content="{DynamicResource Common.Close}"/>
                    </Grid>
                </Border>

                <controls:RecentSalesList Grid.Row="1"
                                          ItemsSource="{Binding RecentSales}"
                                          OpenCommand="{Binding OpenReceiptCommand}"/>

                <Border Grid.Row="2"
                        Style="{StaticResource POS.Dialog.Footer}"
                        Padding="{StaticResource Spacing.DialogFooter}">
                    <Grid>
                        <TextBlock Text="{DynamicResource RecentSales.FooterHint}"
                                   Foreground="{StaticResource Color.Text.Muted}"
                                   FontSize="{StaticResource Font.Size.Sm}"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource POS.Button.Secondary}"
                                Content="{DynamicResource Common.Close}"
                                Command="{Binding CloseDialogCommand}"
                                MinHeight="{StaticResource Size.TouchTarget.Min}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
