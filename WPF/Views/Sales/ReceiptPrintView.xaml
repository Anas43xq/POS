<UserControl x:Class="UI.Views.ReceiptPrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             mc:Ignorable="d">

    <StackPanel UseLayoutRounding="True"
                SnapsToDevicePixels="True"
                Margin="16">

        <Image Source="pack://application:,,,/UI;component/Assets/receiptlogo.png"
               Width="100"
               Height="100"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               Margin="4"/>

        <TextBlock Text="{Binding StoreName}"
                   FontSize="14"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   Foreground="{StaticResource Color.Text.Default}"
                   Margin="4"/>

        <TextBlock Text="SALES RECEIPT"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   Foreground="{StaticResource Color.Text.Default}"
                   Margin="12"/>

        <TextBlock Text="{Binding ReceiptNumber, StringFormat=Receipt: {0}}"
                   FontSize="13"
                   Foreground="{StaticResource Color.Text.Default}"
                   Margin="4"/>

        <TextBlock Text="{Binding TransactionDate, StringFormat=Date: {0:yyyy-MM-dd HH:mm}}"
                   FontSize="13"
                   Foreground="{StaticResource Color.Text.Default}"
                   Margin="4"/>

        <Separator Margin="12"/>

        <TextBlock Text="ITEMS"
                   FontWeight="Bold"
                   Foreground="{StaticResource Color.Text.Default}"
                   Margin="4"/>

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding ProductName}"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Color.Text.Default}"/>

                        <ItemsControl ItemsSource="{Binding Modifiers}"
                                      Margin="6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11"
                                               Foreground="{StaticResource Color.Text.Secondary}"
                                               Text="{Binding Converter={StaticResource ModifierLineConverter}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Quantity}"
                                           FontSize="11"
                                           Foreground="{StaticResource Color.Text.Default}"/>
                                <TextBlock Text=" x "
                                           FontSize="11"
                                           Foreground="{StaticResource Color.Text.Default}"/>
                                <controls:CurrencyText Amount="{Binding UnitPrice}"
                                                       AmountForeground="{StaticResource Color.Text.Default}"
                                                       FontSize="11"
                                                       FontWeight="Medium"/>
                            </StackPanel>

                            <controls:CurrencyText Grid.Column="1"
                                                   Amount="{Binding LineTotal}"
                                                   AmountForeground="{StaticResource Color.Text.Default}"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Margin="12"/>

        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Subtotal"
                       Foreground="{StaticResource Color.Text.Default}"/>
            <controls:CurrencyText Grid.Column="1"
                                   Amount="{Binding Subtotal}"
                                   AmountForeground="{StaticResource Color.Text.Default}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tax"
                       Foreground="{StaticResource Color.Text.Default}"/>
            <controls:CurrencyText Grid.Column="1"
                                   Amount="{Binding TaxTotal}"
                                   AmountForeground="{StaticResource Color.Text.Default}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Discount"
                       Foreground="{StaticResource Color.Text.Default}"/>
            <controls:CurrencyText Grid.Column="1"
                                   Amount="{Binding DiscountTotal}"
                                   AmountForeground="{StaticResource Color.Text.Default}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="GRAND TOTAL"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{StaticResource Color.Text.Default}"/>
            <controls:CurrencyText Grid.Column="1"
                                   Amount="{Binding GrandTotal}"
                                   AmountForeground="{StaticResource Color.Text.Default}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Separator Margin="4"/>

        <TextBlock Text="{Binding PaymentMethod, StringFormat=Payment: {0}}"
                   Foreground="{StaticResource Color.Text.Default}"
                   Margin="4"/>

        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Amount Tendered:"
                       Foreground="{StaticResource Color.Text.Default}"/>
            <controls:CurrencyText Grid.Column="1"
                                   Amount="{Binding AmountTendered}"
                                   AmountForeground="{StaticResource Color.Text.Default}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Change:"
                       Foreground="{StaticResource Color.Text.Default}"/>
            <controls:CurrencyText Grid.Column="1"
                                   Amount="{Binding ChangeGiven}"
                                   AmountForeground="{StaticResource Color.Text.Default}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <TextBlock Text="Thank you!"
                   TextAlignment="Center"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource Color.Text.Default}"
                   Margin="12"/>
    </StackPanel>
</UserControl>
