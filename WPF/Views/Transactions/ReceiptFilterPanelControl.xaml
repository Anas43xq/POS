<UserControl x:Class="UI.Views.ReceiptFilterPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             mc:Ignorable="d" d:DesignHeight="46" d:DesignWidth="1420">

    <Border Style="{StaticResource POS.FilterPanel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid VerticalAlignment="Center" Margin="{StaticResource Spacing.2}">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource POS.TextBox.Search}"
                             Width="200"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Border Width="1" Height="20" Background="{StaticResource Color.Border.Default}" Margin="{StaticResource Spacing.2}"/>

                <controls:DateRangeFilterControl
                    SelectedDateRange="{Binding SelectedDateRange}"
                    FromDate="{Binding DateFrom, Mode=TwoWay}"
                    ToDate="{Binding DateTo, Mode=TwoWay}"
                    DayCommand="{Binding LoadDayCommand}"
                    WeekCommand="{Binding LoadWeekCommand}"
                    MonthCommand="{Binding LoadMonthCommand}"
                    PeriodCommand="{Binding LoadPeriodCommand}"
                    DayLabel="{DynamicResource Common.Day}"
                    WeekLabel="{DynamicResource Common.Week}"
                    MonthLabel="{DynamicResource Common.Month}"
                    PeriodLabel="{DynamicResource Common.Period}"/>

                <Border Width="1" Height="20" Background="{StaticResource Color.Border.Default}" Margin="{StaticResource Spacing.2}"/>

                <TextBlock Text="{DynamicResource Common.From}"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource Font.Size.Sm}"
                           Foreground="{StaticResource Color.Text.Muted}"
                           Margin="{StaticResource Spacing.1}"/>
                <DatePicker Style="{StaticResource DateInput}"
                            SelectedDate="{Binding DateFrom, Mode=TwoWay}"
                            Margin="{StaticResource Spacing.3}"/>
                <TextBlock Text="{DynamicResource Common.To}"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource Font.Size.Sm}"
                           Foreground="{StaticResource Color.Text.Muted}"
                           Margin="{StaticResource Spacing.1}"/>
                <DatePicker Style="{StaticResource DateInput}"
                            SelectedDate="{Binding DateTo, Mode=TwoWay}"
                            Margin="{StaticResource Spacing.3}"/>

                <Border Width="1" Height="20" Background="{StaticResource Color.Border.Default}" Margin="{StaticResource Spacing.2}"/>

                <ComboBox Style="{StaticResource POS.ComboBox.Default}"
                          ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                          DisplayMemberPath="CompanyName"
                          Width="160"/>

                <Border Width="1" Height="20" Background="{StaticResource Color.Border.Default}" Margin="{StaticResource Spacing.2}"/>

                <TextBox Style="{StaticResource POS.TextBox.Default}"
                         Width="160"
                         Text="{Binding CategoryFilter, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource POS.Button.Secondary}"
                        Content="{DynamicResource Common.Reset}"
                        Margin="{StaticResource Spacing.1}"
                        Command="{Binding ResetFiltersCommand}"/>
                <Button Style="{StaticResource POS.Button.Secondary}"
                        Content="{DynamicResource Common.Refresh}"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
