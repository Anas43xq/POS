<!--
    ╔══════════════════════════════════════════════════════╗
    ║   PurchaseReceiptToolbarControl                      ║
    ║   Reusable action bar for VAT / Non-VAT purchase      ║
    ║   receipt tabs. The Sales tab uses its own simpler    ║
    ║   toolbar (only "Open" + "Refresh") because its        ║
    ║   functionality differs.                              ║
    ║                                                       ║
    ║   Hierarchy:                                          ║
    ║     Primary:  Add (filled brand button)              ║
    ║     Secondary: Edit / View / Export (outline)         ║
    ║     Destructive: Delete (red)                          ║
    ║                                                       ║
    ║   All commands / IsEnabled booleans are bound to the   ║
    ║   host page's ViewModel.  Inherits the parent          ║
    ║   DataContext.  No DataContext of its own.            ║
    ╚══════════════════════════════════════════════════════╝
-->
<UserControl x:Class="UI.Views.PurchaseReceiptToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="32" d:DesignWidth="500">

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- ── Primary: Add ── -->
        <Button Style="{StaticResource POS.Button.Primary}"
                Margin="{StaticResource Spacing.1}"
                Command="{Binding AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="＋  " FontSize="{StaticResource Font.Size.Base}"/>
                <TextBlock Text="{Binding AddLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="{StaticResource Font.Size.Sm}"
                           FontWeight="{StaticResource Font.Weight.Medium}"/>
            </StackPanel>
        </Button>

        <!-- ── Secondary: Edit ── -->
        <Button Style="{StaticResource POS.Button.CrudSurface}"
                Margin="{StaticResource Spacing.1}"
                IsEnabled="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Command="{Binding EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✏  " FontSize="{StaticResource Font.Size.Sm}"/>
                <TextBlock Text="{Binding EditLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="{StaticResource Font.Size.Sm}"/>
            </StackPanel>
        </Button>

        <!-- ── Secondary: View ── -->
        <Button Style="{StaticResource POS.Button.Secondary}"
                Margin="{StaticResource Spacing.1}"
                IsEnabled="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Command="{Binding ViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="👁  " FontSize="{StaticResource Font.Size.Sm}"/>
                <TextBlock Text="{Binding ViewLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="{StaticResource Font.Size.Sm}"/>
            </StackPanel>
        </Button>

        <!-- ── Destructive: Delete ── -->
        <Button Style="{StaticResource POS.Button.Danger}"
                Margin="{StaticResource Spacing.1}"
                IsEnabled="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🗑  " FontSize="{StaticResource Font.Size.Sm}"/>
                <TextBlock Text="{Binding DeleteLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="{StaticResource Font.Size.Sm}"/>
            </StackPanel>
        </Button>

        <!-- ── Secondary: Export (divider before) ── -->
        <Border Width="1" Height="18" Background="{StaticResource Color.Border.Default}" Margin="{StaticResource Spacing.1}"/>
        <Button Style="{StaticResource POS.Button.Secondary}"
                Command="{Binding ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⬇  " FontSize="{StaticResource Font.Size.Sm}"/>
                <TextBlock Text="{Binding ExportLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="{StaticResource Font.Size.Sm}"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
