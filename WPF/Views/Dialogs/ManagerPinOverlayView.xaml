<Window x:Class="UI.Views.ManagerPinOverlayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Manager Approval"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        d:DesignWidth="360" d:DesignHeight="540">

    <Grid Background="{StaticResource Color.Brand.Scrim}">
        <Border Width="360"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Style="{StaticResource POS.Dialog.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Style="{StaticResource POS.Dialog.Header}"
                        Padding="{StaticResource Spacing.RoleRowPadding}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="{StaticResource Radius.Sm}"
                                    Background="{StaticResource Color.Brand.Dark}"
                                    Margin="{StaticResource Spacing.HeaderLogoMargin}">
                                <TextBlock Text="PIN"
                                           FontSize="{StaticResource Font.Size.Xs}"
                                           FontWeight="{StaticResource Font.Weight.Bold}"
                                           Foreground="{StaticResource Color.Text.OnBrand}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding PromptTitle, FallbackValue='Manager Approval'}"
                                           FontSize="{StaticResource Font.Size.Lg}"
                                           FontWeight="{StaticResource Font.Weight.SemiBold}"
                                           Foreground="{StaticResource Color.Text.Default}"/>
                                <TextBlock Text="{DynamicResource ManagerPin.Subtitle}"
                                           FontSize="{StaticResource Font.Size.Sm}"
                                           Foreground="{StaticResource Color.Text.Muted}"
                                           Margin="{StaticResource Spacing.DialogTitleGap}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource POS.Dialog.CloseButton}"
                                Content="&#x2715;"
                                Command="{Binding CancelCommand}"/>
                    </Grid>
                </Border>

                <!-- PIN indicator + no-PIN notice + error banner + reason -->
                <StackPanel Grid.Row="1" Margin="{StaticResource Spacing.DialogBodyMargin}">
                    <!-- No-PIN banner: shown when the manager has not set an override PIN -->
                    <Border Style="{StaticResource POS.Dialog.NoticeWarning}"
                            Margin="{StaticResource Spacing.DialogErrorBannerMargin}"
                            Visibility="{Binding ShowPinNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource ManagerPin.NoPinBanner}"
                                   Style="{StaticResource POS.Dialog.ErrorText}"
                                   Foreground="{StaticResource Color.Text.Warning}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Style="{StaticResource POS.Dialog.PinDot.1}"/>
                        <Ellipse Style="{StaticResource POS.Dialog.PinDot.2}"/>
                        <Ellipse Style="{StaticResource POS.Dialog.PinDot.3}"/>
                        <Ellipse Style="{StaticResource POS.Dialog.PinDot.4}"/>
                    </StackPanel>

                    <!-- Centered "set a PIN in Settings" message shown when no PIN exists -->
                    <TextBlock Text="{DynamicResource ManagerPin.NoPinMessage}"
                               Style="{StaticResource POS.Dialog.ErrorText}"
                               Foreground="{StaticResource Color.Text.Warning}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="{StaticResource Spacing.DialogFieldGap}"
                               Visibility="{Binding ShowPinNotice, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Border Style="{StaticResource POS.Dialog.NoticeDanger}"
                            Margin="{StaticResource Spacing.DialogErrorBannerMargin}"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource POS.Dialog.ErrorText}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Margin="{StaticResource Spacing.DialogFieldGap}"
                                Visibility="{Binding ReasonRequired, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource ManagerPin.ReasonLabel}"
                                   FontSize="{StaticResource Font.Size.Xs}"
                                   FontWeight="{StaticResource Font.Weight.SemiBold}"
                                   Foreground="{StaticResource Color.Text.Muted}"
                                   Margin="{StaticResource Spacing.DialogLabelGap}"/>
                        <Border Style="{StaticResource POS.Dialog.InputBorder}"
                                CornerRadius="{StaticResource Radius.Default}">
                            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource POS.TextBox.Borderless}"
                                     Tag="{DynamicResource ManagerPin.ReasonPlaceholder}"
                                     AcceptsReturn="False"
                                     MaxLength="200"
                                     MinHeight="{StaticResource Size.TouchTarget.Min}"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Numpad — disabled until an override PIN is set -->
                <Grid Grid.Row="2"
                      Margin="{StaticResource Spacing.DialogBodyMargin}"
                      IsEnabled="{Binding IsPinSet}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource POS.Dialog.NumpadKey}" Command="{Binding DigitCommand}" CommandParameter="1"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource POS.Dialog.NumpadKey}" Command="{Binding DigitCommand}" CommandParameter="2"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource POS.Dialog.NumpadKey}" Command="{Binding DigitCommand}" CommandParameter="3"/>

                    <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource POS.Dialog.NumpadKey}" Command="{Binding DigitCommand}" CommandParameter="4"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource POS.Dialog.NumpadKey}" Command="{Binding DigitCommand}" CommandParameter="5"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource POS.Dialog.NumpadKey}" Command="{Binding DigitCommand}" CommandParameter="6"/>

                    <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource POS.Dialog.NumpadKey}" Command="{Binding DigitCommand}" CommandParameter="7"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource POS.Dialog.NumpadKey}" Command="{Binding DigitCommand}" CommandParameter="8"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource POS.Dialog.NumpadKey}" Command="{Binding DigitCommand}" CommandParameter="9"/>

                    <Button Grid.Row="3" Grid.Column="0" Content="&#x232B;" Style="{StaticResource POS.Dialog.NumpadKey}" Command="{Binding BackspaceCommand}"/>
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource POS.Dialog.NumpadKey}" Command="{Binding DigitCommand}" CommandParameter="0"/>
                    <Button Grid.Row="3" Grid.Column="2"
                            Style="{StaticResource POS.Button.Primary}"
                            Content="&#x2713;"
                            MinWidth="{StaticResource Size.TouchTarget.Min}"
                            MinHeight="{StaticResource Size.TouchTarget.Min}"
                            Margin="{StaticResource Spacing.Xs}"
                            IsDefault="True"
                            Command="{Binding ConfirmCommand}"/>
                </Grid>

                <!-- Footer — Cancel only -->
                <!-- IsCancel="True" is intentionally NOT used: for WindowStyle=None custom-chrome windows
                     IsCancel does not reliably fire the close sequence through the ViewModel.
                     CancelCommand handles it explicitly (same fix as LoginWindow). -->
                <Border Grid.Row="3"
                        Style="{StaticResource POS.Dialog.Footer}"
                        Padding="{StaticResource Spacing.DialogFooter}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource POS.Button.Secondary}"
                                Content="{DynamicResource Common.Cancel}"
                                MinHeight="{StaticResource Size.TouchTarget.Min}"
                                Command="{Binding CancelCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
