<!--
    Modifier Option Edit Form — inline UserControl
    Shown/hidden via IsEditingOption visibility toggle on the parent.
    DataContext: ModifierGroupManagementViewModel
-->
<UserControl x:Class="UI.Views.Modifiers.ModifierOptionEditFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="500" d:DesignHeight="350">

    <Border Background="{StaticResource Color.Surface.Default}"
            BorderBrush="{StaticResource Color.Border.Default}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Lg}"
            Padding="{StaticResource Spacing.3}"
            Margin="{StaticResource Spacing.3}">
        <StackPanel>
            <TextBlock Text="{DynamicResource Manager.ModifierOption.OptionDetails}"
                       FontSize="{StaticResource Font.Size.Base}"
                       FontWeight="{StaticResource Font.Weight.SemiBold}"
                       Foreground="{StaticResource Color.Text.Default}"
                       Margin="{StaticResource Spacing.3}"/>

            <TextBlock Text="{DynamicResource Common.Name}"
                       FontSize="{StaticResource Font.Size.Sm}"
                       FontWeight="{StaticResource Font.Weight.Medium}"
                       Foreground="{StaticResource Color.Text.Muted}"
                        Margin="{StaticResource Spacing.1}"/>
            <TextBox Text="{Binding EditOptionName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource POS.TextBox.Default}"
                     Margin="{StaticResource Spacing.3}"/>

            <StackPanel Orientation="Horizontal" Margin="{StaticResource Spacing.3}">
                <StackPanel Margin="{StaticResource Spacing.3}">
                    <TextBlock Text="{DynamicResource Manager.ModifierOption.PriceAdd}"
                               FontSize="{StaticResource Font.Size.Sm}"
                               FontWeight="{StaticResource Font.Weight.Medium}"
                               Foreground="{StaticResource Color.Text.Muted}"
                               Margin="{StaticResource Spacing.1}"/>
                    <TextBox Text="{Binding EditOptionPrice, UpdateSourceTrigger=PropertyChanged}"
                             Width="100"
                             Style="{StaticResource POS.TextBox.Default}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Manager.ModifierOption.DisplayOrder}"
                               FontSize="{StaticResource Font.Size.Sm}"
                               FontWeight="{StaticResource Font.Weight.Medium}"
                               Foreground="{StaticResource Color.Text.Muted}"
                        Margin="{StaticResource Spacing.1}"/>
                    <TextBox Text="{Binding EditOptionSortOrder, UpdateSourceTrigger=PropertyChanged}"
                             Width="80"
                             Style="{StaticResource POS.TextBox.Default}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="{StaticResource Spacing.3}">
                <CheckBox Content="{DynamicResource Manager.ModifierOption.AllowQuantity}"
                          IsChecked="{Binding EditOptionAllowQuantity}"
                          Style="{StaticResource POS.CheckBox.Default}"
                           Margin="{StaticResource Spacing.4}"/>
                <CheckBox Content="{DynamicResource Manager.ModifierOption.DefaultRegular}"
                          IsChecked="{Binding EditOptionIsDefault}"
                          Style="{StaticResource POS.CheckBox.Default}"
                           Margin="{StaticResource Spacing.4}"/>
                <CheckBox Content="{DynamicResource Manager.ModifierOption.Active}"
                          IsChecked="{Binding EditOptionIsActive}"
                          Style="{StaticResource POS.CheckBox.Default}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource POS.Button.Primary}"
                        Content="{DynamicResource Manager.ModifierOption.SaveOption}"
                        Command="{Binding SaveOptionCommand}"
                        Margin="{StaticResource Spacing.2}"/>
                <Button Style="{StaticResource POS.Button.Secondary}"
                        Content="{DynamicResource Common.Cancel}"
                        Command="{Binding CancelOptionEditCommand}"
                        Margin="{StaticResource Spacing.2}"/>
                <Button Style="{StaticResource POS.Button.Secondary}"
                        Content="{DynamicResource Manager.ModifierOption.TranslationsButton}"
                        Command="{Binding OptionTranslationsCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
