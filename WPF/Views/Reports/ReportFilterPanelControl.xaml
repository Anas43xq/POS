<!--
    ╔══════════════════════════════════════════════════════╗
    ║   Reports filter bar. One adaptive panel for all       ║
    ║   two report modes — avoids near-identical filter      ║
    ║   panels. Top row: Sales/Sales Analysis segmented      ║
    ║   toggle + Generate/Export action. Bottom row: the     ║
    ║   shared <controls:DateRangeFilterControl/> (same      ║
    ║   mechanism as Home/Transactions/Shifts). Sales        ║
    ║   Analysis mode only needs the shared date filter, so  ║
    ║   it reuses the same row unchanged.                    ║
    ║   No DataContext of its own — inherits the host VM.    ║
    ╚══════════════════════════════════════════════════════╝
-->
<UserControl x:Class="UI.Views.ReportFilterPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             mc:Ignorable="d" d:DesignHeight="90" d:DesignWidth="1420">

    <Border Style="{StaticResource POS.FilterPanel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource FilterChip}"
                             GroupName="ReportMode"
                             Content="{DynamicResource Manager.Reports.SalesMode}"
                             IsChecked="{Binding IsSalesMode}"/>
                <RadioButton Style="{StaticResource FilterChip}"
                             GroupName="ReportMode"
                             Content="{DynamicResource Manager.Reports.SalesAnalysisMode}"
                             IsChecked="{Binding IsSalesAnalysisMode}"/>
            </StackPanel>

            <controls:DateRangeFilterControl
                Grid.Column="1"
                DayCommand="{Binding FilterTodayCommand}"
                WeekCommand="{Binding FilterThisWeekCommand}"
                MonthCommand="{Binding FilterMonthCommand}"
                PeriodCommand="{Binding ShowPeriodFilterCommand}"
                ApplyCommand="{Binding ApplyPeriodFilterCommand}"
                IsPeriodFilterVisible="{Binding IsPeriodFilterVisible}"
                FromDate="{Binding FromDate, Mode=TwoWay}"
                ToDate="{Binding ToDate, Mode=TwoWay}"
                DayLabel="{DynamicResource Common.Today}"
                WeekLabel="{DynamicResource Common.ThisWeek}"
                MonthLabel="{DynamicResource Common.ThisMonth}"
                PeriodLabel="{DynamicResource Common.Period}"
                FromLabel="{DynamicResource Common.From}"
                ToLabel="{DynamicResource Common.To}"
                ApplyButtonText="{DynamicResource Common.Apply}"/>

            <Button Grid.Column="2"
                    Style="{StaticResource POS.Button.Primary}"
                    Content="{DynamicResource Manager.Reports.GenerateExport}"
                    Command="{Binding ReportCommand}"
                    CommandParameter="GenerateAndExport"/>
        </Grid>
    </Border>
</UserControl>
