<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Phase 3 entry point for top-level window chrome.
        This file intentionally starts small: it provides stable shell
        styles that can be adopted by windows without changing view logic
        or code-behind, and it keeps the actual visual values sourced from
        shared tokens.
    -->

    <!-- Standard window shell: used by regular app windows. -->
    <Style x:Key="POS.Window.Shell" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
        <Setter Property="BorderBrush" Value="{x:Static Brushes.Transparent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Base}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Transparent shell for chrome-hosted dialogs. -->
    <Style x:Key="POS.Window.Overlay" TargetType="Window" BasedOn="{StaticResource POS.Window.Shell}">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="Background" Value="{x:Static Brushes.Transparent}"/>
        <Setter Property="BorderBrush" Value="{x:Static Brushes.Transparent}"/>
        <Setter Property="AllowsTransparency" Value="True"/>
    </Style>

    <!-- Compatibility aliases for future migration steps. -->
    <Style x:Key="WindowShell" TargetType="Window" BasedOn="{StaticResource POS.Window.Shell}"/>
    <Style x:Key="WindowOverlay" TargetType="Window" BasedOn="{StaticResource POS.Window.Overlay}"/>
</ResourceDictionary>
