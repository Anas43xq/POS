<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:UI.Controls">
    <!-- Manager chrome brushes ─ used by ManagerMainView (GradientStop.Color requires inline hex) -->
    <LinearGradientBrush x:Key="POS.Manager.LogoBadgeGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A6FC4" Offset="0"/>
        <GradientStop Color="#2589E0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="POS.Manager.SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F2A4A" Offset="0"/>
        <GradientStop Color="#1A3A5C" Offset="1"/>
    </LinearGradientBrush>

    <!-- Manager header top border — bottom hairline only, matches WPF chrome convention -->
    <Style x:Key="POS.Manager.HeaderBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Default}"/>
        <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.HeaderPadding}"/>
    </Style>

    <Style x:Key="POS.FilterPanel"
           TargetType="Border"
           BasedOn="{StaticResource POS.Dialog.InputBorder}">
        <Setter Property="Background" Value="{StaticResource Color.Surface.Default}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.3}"/>
    </Style>

    <Style x:Key="POS.Manager.Card"
           TargetType="Border"
           BasedOn="{StaticResource POS.Dialog.InputBorder}">
        <Setter Property="Background" Value="{StaticResource Color.Surface.Default}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Default}"/>
    </Style>

    <Style x:Key="POS.Manager.CardHeader"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Brand.Light}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.BrandSubtle}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.BottomHalf}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.3}"/>
    </Style>

    <Style x:Key="POS.Manager.CardTitle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Base}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="POS.Manager.KpiTile"
           TargetType="Border"
           BasedOn="{StaticResource POS.Dialog.InputBorder}">
        <Setter Property="Background" Value="{StaticResource Color.Brand.Light}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.BrandSoft}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.2}"/>
    </Style>

    <Style x:Key="POS.Manager.KpiLabel"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.SidebarLabel}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Muted}"/>
        <Setter Property="Margin" Value="{StaticResource Spacing.Xxs}"/>
    </Style>

    <Style x:Key="POS.Manager.KpiValue"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Xl}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
    </Style>

    <Style x:Key="POS.Manager.KpiValueCurrency"
           TargetType="controls:CurrencyText">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Xl}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="AmountForeground" Value="{StaticResource Color.Text.Primary}"/>
    </Style>

    <Style x:Key="CardBorder"
           TargetType="Border"
           BasedOn="{StaticResource POS.Manager.Card}"/>
    <Style x:Key="CardHeaderBorder"
           TargetType="Border"
           BasedOn="{StaticResource POS.Manager.CardHeader}"/>
    <Style x:Key="POS.Manager.HomeCardHeader"
           TargetType="Border"
           BasedOn="{StaticResource POS.Manager.CardHeader}">
        <Setter Property="MinHeight" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.0}"/>
    </Style>
    <Style x:Key="POS.Manager.HomeCardTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource POS.Manager.CardTitle}">
        <Setter Property="Margin" Value="{StaticResource Spacing.1}"/>
    </Style>
    <Style x:Key="CardTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource POS.Manager.CardTitle}"/>
    <Style x:Key="DashboardKpiTile"
           TargetType="Border"
           BasedOn="{StaticResource POS.Manager.KpiTile}"/>
    <Style x:Key="DashboardKpiLabel"
           TargetType="TextBlock"
           BasedOn="{StaticResource POS.Manager.KpiLabel}"/>
    <Style x:Key="DashboardKpiValue"
           TargetType="TextBlock"
           BasedOn="{StaticResource POS.Manager.KpiValue}"/>
    <Style x:Key="DashboardKpiValueCurrency"
           TargetType="controls:CurrencyText"
           BasedOn="{StaticResource POS.Manager.KpiValueCurrency}"/>

    <Style x:Key="POS.Manager.HomeListPrimaryText"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Base}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="POS.Manager.HomeListMetaText"
           TargetType="TextBlock"
           BasedOn="{StaticResource POS.Badge.Text}">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Xs}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Muted}"/>
    </Style>

    <Style x:Key="POS.Manager.EmptyStateText"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Base}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Muted}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="POS.Manager.ModifierGroupCard"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Selection}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource Color.Brand.Selection}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="POS.Manager.ModifierMetaText"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Sm}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="POS.Manager.ModifierFieldLabel"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Xs}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Muted}"/>
        <Setter Property="Margin" Value="{StaticResource Spacing.DialogLabelGap}"/>
    </Style>

    <Style x:Key="POS.Manager.ModifierFieldValue"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Base}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Default}"/>
    </Style>

    <Style x:Key="POS.Manager.WarningBadge"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Warning.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Warning.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.1}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="POS.Manager.WarningBadgeText"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Xs}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Warning.Dark}"/>
    </Style>

    <Style x:Key="POS.Manager.CategoryCard"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Selection}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource Color.Brand.Selection}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="POS.Manager.SubcategoryCard"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Selection}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource Color.Brand.Selection}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="POS.Manager.CategoryCardImage"
           TargetType="Image">
        <Setter Property="Width" Value="{StaticResource Size.Icon.Lg}"/>
        <Setter Property="Height" Value="{StaticResource Size.Icon.Lg}"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="POS.Manager.HomeCashDifferenceText"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Sm}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Success.Default}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsShortfall}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Color.Danger.Default}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ListHeaderCell" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Muted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="ThinScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="ListRow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
    </Style>

    <Style x:Key="SelectedListRow" TargetType="Border" BasedOn="{StaticResource ListRow}">
        <Setter Property="Background" Value="{StaticResource Color.Brand.Selection}"/>
    </Style>

    <Style x:Key="BadgeBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="POS.Manager.SidebarSectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Xs}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Nav.IdleForeground}"/>
        <Setter Property="Margin" Value="{StaticResource Spacing.4}"/>
    </Style>

    <Style x:Key="POS.Manager.NavIconImage" TargetType="Image">
        <Setter Property="Width" Value="{StaticResource Size.Icon.Sm}"/>
        <Setter Property="Height" Value="{StaticResource Size.Icon.Sm}"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <Style x:Key="POS.Manager.NavLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Sm}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.OnBrand}"/>
    </Style>

    <Style x:Key="POS.Manager.NavItem" TargetType="RadioButton">
        <Setter Property="GroupName" Value="ManagerNav"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0"
                            Padding="{StaticResource Spacing.NavItemPadding}">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ContentPresenter Content="{TemplateBinding Tag}"
                                              Margin="{StaticResource Spacing.NavIconMargin}"
                                              VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Nav.HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Nav.ActiveBackground}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
