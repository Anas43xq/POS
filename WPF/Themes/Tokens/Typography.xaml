<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <FontFamily x:Key="Font.Family.Default">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Family.Medium">Segoe UI Semibold</FontFamily>

    <sys:Double x:Key="Font.Size.Xs">10</sys:Double>
    <sys:Double x:Key="Font.Size.Sm">11</sys:Double>
    <sys:Double x:Key="Font.Size.Base">12</sys:Double>
    <sys:Double x:Key="Font.Size.Md">13</sys:Double>
    <sys:Double x:Key="Font.Size.Lg">14</sys:Double>
    <sys:Double x:Key="Font.Size.Xl">16</sys:Double>
    <sys:Double x:Key="Font.Size.2Xl">18</sys:Double>
    <sys:Double x:Key="Font.Size.Caption">10.5</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">11.5</sys:Double>
    <sys:Double x:Key="Font.Size.DisplaySm">13.5</sys:Double>
    <sys:Double x:Key="Font.Size.Display">18</sys:Double>
    <sys:Double x:Key="Font.Size.SidebarLabel">9</sys:Double>
    <sys:Double x:Key="Font.Size.NavIcon">15</sys:Double>
    <sys:Double x:Key="Font.Size.Title">20</sys:Double>

    <FontWeight x:Key="Font.Weight.Normal">Normal</FontWeight>
    <FontWeight x:Key="Font.Weight.Medium">Medium</FontWeight>
    <FontWeight x:Key="Font.Weight.SemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="Font.Weight.Bold">Bold</FontWeight>
</ResourceDictionary>
