<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:UI.Controls">
    <Style x:Key="POS.Dialog.Card"
           TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Xl}"/>
        <Setter Property="Background" Value="{StaticResource Color.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Brand}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Lg}"/>
    </Style>

    <Style x:Key="POS.Dialog.Overlay"
           TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource Color.Brand.Scrim}"/>
    </Style>

    <Style x:Key="POS.Dialog.Header"
           TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Xl}"/>
        <Setter Property="Background" Value="{StaticResource Color.Brand.Light}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Brand}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="POS.Dialog.Footer"
           TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Xl}"/>
        <Setter Property="Background" Value="{StaticResource Color.Brand.Light}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Brand}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <Style x:Key="POS.Dialog.CloseButton"
           TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Md}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.CoolSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Brand.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Brand.Selection}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.CoolSoft}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                            <Setter TargetName="Root" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Text.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="POS.Dialog.Label"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Sm}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Brand.Dark}"/>
    </Style>

    <Style x:Key="POS.Dialog.Title"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Lg}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="POS.Dialog.SectionLabel"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Sm}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Muted}"/>
    </Style>

    <Style x:Key="POS.Dialog.TableHeaderText"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Xs}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Secondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="POS.Dialog.CurrencyPrefix"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Sm}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Muted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="POS.Dialog.IconBadge"
           TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Size.Icon.Lg}"/>
        <Setter Property="Height" Value="{StaticResource Size.Icon.Lg}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Background" Value="{StaticResource Color.Brand.Dark}"/>
    </Style>

    <Style x:Key="POS.Dialog.IconGlyph"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Lg}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.OnBrand}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="POS.Dialog.InputBorder"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Brand}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Default}"/>
    </Style>

    <Style x:Key="POS.Dialog.NoticeDanger"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Danger.ErrorSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Danger.ErrorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.DialogError}"/>
    </Style>

    <Style x:Key="POS.Dialog.NoticeWarning"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Surface.Warning}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Warning.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.DialogError}"/>
    </Style>

    <Style x:Key="POS.Dialog.PricePanel"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Brand.Light}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Brand}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.3}"/>
    </Style>

    <Style x:Key="POS.Dialog.ActivePanel"
           TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Brand.Light}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Brand}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.3}"/>
    </Style>

    <Style x:Key="POS.Dialog.ErrorText"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Sm}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Danger.Dark}"/>
    </Style>

    <Style x:Key="POS.Dialog.KpiLabel"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Xs}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Muted}"/>
        <Setter Property="Margin" Value="{StaticResource Spacing.1}"/>
    </Style>

    <Style x:Key="POS.Dialog.KpiValue"
           TargetType="controls:CurrencyText">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Lg}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Default}"/>
    </Style>

    <Style x:Key="POS.Dialog.KpiValueDifference"
           TargetType="controls:CurrencyText">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Lg}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Success.Default}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Detail.CashDifference}" Value="{x:Null}">
                <Setter Property="Foreground" Value="{StaticResource Color.Text.Muted}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Settings panel styles -->
    <Style x:Key="POS.Settings.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.NavIcon}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="Margin" Value="{StaticResource Spacing.Settings.ControlGap}"/>
    </Style>

    <Style x:Key="POS.Settings.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Base}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Brand.Dark}"/>
        <Setter Property="Margin" Value="{StaticResource Spacing.Settings.LabelGap}"/>
    </Style>

    <Style x:Key="POS.Settings.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Title}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Bold}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="Margin" Value="{StaticResource Spacing.Settings.TitleGap}"/>
    </Style>

    <Style x:Key="POS.Settings.WarningNotice" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.Warning.Light}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Warning}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Default}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.3}"/>
    </Style>

    <Style x:Key="POS.Settings.WarningText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Base}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Warning.Dark}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
<!-- ==========================================================
         Manager PIN overlay — indicator dots + numpad key
         Styles live here (controls layer), never inside a view.
         ========================================================== -->
    <Style x:Key="POS.Dialog.PinDot" TargetType="Ellipse">
        <Setter Property="Width" Value="{StaticResource Size.Icon.Sm}"/>
        <Setter Property="Height" Value="{StaticResource Size.Icon.Sm}"/>
        <Setter Property="Margin" Value="{StaticResource Spacing.Xs}"/>
        <Setter Property="Fill" Value="{StaticResource Color.Brand.Border}"/>
    </Style>

    <!-- Dot 1 (empty when fewer than 1 digit entered) -->
    <Style x:Key="POS.Dialog.PinDot.1" TargetType="Ellipse" BasedOn="{StaticResource POS.Dialog.PinDot}">
        <Setter Property="Fill" Value="{StaticResource Color.Brand.Primary}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding PinLength}" Value="0">
                <Setter Property="Fill" Value="{StaticResource Color.Brand.Border}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Dot 2 (empty when fewer than 2 digits entered) -->
    <Style x:Key="POS.Dialog.PinDot.2" TargetType="Ellipse" BasedOn="{StaticResource POS.Dialog.PinDot}">
        <Setter Property="Fill" Value="{StaticResource Color.Brand.Primary}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding PinLength}" Value="0">
                <Setter Property="Fill" Value="{StaticResource Color.Brand.Border}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding PinLength}" Value="1">
                <Setter Property="Fill" Value="{StaticResource Color.Brand.Border}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Dot 3 (empty when fewer than 3 digits entered) -->
    <Style x:Key="POS.Dialog.PinDot.3" TargetType="Ellipse" BasedOn="{StaticResource POS.Dialog.PinDot}">
        <Setter Property="Fill" Value="{StaticResource Color.Brand.Primary}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding PinLength}" Value="0">
                <Setter Property="Fill" Value="{StaticResource Color.Brand.Border}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding PinLength}" Value="1">
                <Setter Property="Fill" Value="{StaticResource Color.Brand.Border}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding PinLength}" Value="2">
                <Setter Property="Fill" Value="{StaticResource Color.Brand.Border}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Dot 4 (empty when fewer than 4 digits entered) -->
    <Style x:Key="POS.Dialog.PinDot.4" TargetType="Ellipse" BasedOn="{StaticResource POS.Dialog.PinDot}">
        <Setter Property="Fill" Value="{StaticResource Color.Brand.Primary}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding PinLength}" Value="0">
                <Setter Property="Fill" Value="{StaticResource Color.Brand.Border}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding PinLength}" Value="1">
                <Setter Property="Fill" Value="{StaticResource Color.Brand.Border}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding PinLength}" Value="2">
                <Setter Property="Fill" Value="{StaticResource Color.Brand.Border}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding PinLength}" Value="3">
                <Setter Property="Fill" Value="{StaticResource Color.Brand.Border}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Numpad key — touch-target square key -->
    <Style x:Key="POS.Dialog.NumpadKey" TargetType="Button" BasedOn="{StaticResource POS.Button.Secondary}">
        <Setter Property="MinWidth" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Height" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.2Xl}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}"/>
        <Setter Property="Margin" Value="{StaticResource Spacing.Xs}"/>
    </Style>

    <!-- Settings manager PIN status badge (set vs not set) -->
    <Style x:Key="POS.Settings.PinStatusBadge" TargetType="Border" BasedOn="{StaticResource POS.Badge.Default}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Color.Success.Light}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Success.Border}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPin}" Value="False">
                <Setter Property="Background" Value="{StaticResource Color.Surface.Warning}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Warning}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="POS.Settings.PinStatusText" TargetType="TextBlock" BasedOn="{StaticResource POS.Badge.Text}">
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}"/>
        <Setter Property="Text" Value="&#x2713;  PIN is set"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Success.Dark}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPin}" Value="False">
                <Setter Property="Text" Value="No PIN set"/>
                <Setter Property="Foreground" Value="{StaticResource Color.Text.Warning}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
