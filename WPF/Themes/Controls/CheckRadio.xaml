<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="POS.CheckBox.Default"
           TargetType="CheckBox">
        <Setter Property="MinHeight" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.3}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Box"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource Color.Surface.Default}"
                                    BorderBrush="{StaticResource Color.Border.Brand}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Sm}">
                                <Path x:Name="CheckGlyph"
                                      Data="M 4 10 L 8 14 L 16 6"
                                      Stroke="{StaticResource Color.Text.OnBrand}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              Margin="{StaticResource Spacing.2}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Color.Surface.CoolSoft}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Color.Brand.Primary}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter TargetName="CheckGlyph" Property="Stroke" Value="{StaticResource Color.Text.Disabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Text.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="POS.RadioButton.Default"
           TargetType="RadioButton">
        <Setter Property="MinHeight" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.3}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Ring"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource Color.Surface.Default}"
                                    BorderBrush="{StaticResource Color.Border.Brand}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Pill}">
                                <Ellipse x:Name="Dot"
                                         Width="8"
                                         Height="8"
                                         Fill="{StaticResource Color.Text.OnBrand}"
                                         Visibility="Collapsed"/>
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              Margin="{StaticResource Spacing.2}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Background" Value="{StaticResource Color.Surface.CoolSoft}"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Background" Value="{StaticResource Color.Brand.Primary}"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            <Setter TargetName="Ring" Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Color.Text.Disabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Text.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="POS.ToggleButton.Default"
           TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.3}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Brand.Dark}"/>
        <Setter Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.CoolSoft}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Border.Brand}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Brand.Selection}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Brand.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Text.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="POS.RadioButton.Chip"
           TargetType="RadioButton"
           BasedOn="{StaticResource POS.RadioButton.Default}">
        <Setter Property="Foreground" Value="{StaticResource Color.Brand.Dark}"/>
        <Setter Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.CoolSoft}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Border.Brand}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Brand.Selection}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Brand.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Text.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterChip"
           TargetType="RadioButton"
           BasedOn="{StaticResource POS.RadioButton.Chip}"/>
</ResourceDictionary>
