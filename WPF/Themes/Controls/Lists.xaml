<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:UI.Controls">
    <Style x:Key="POS.ListBoxItem.Default"
           TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.3}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="Background" Value="{StaticResource Color.Surface.Default}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.CoolLighter}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Brand.Selection}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Text.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="POS.ListBox.Default"
           TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Color.Surface.Default}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource POS.ListBoxItem.Default}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style x:Key="POS.ListBox.Item"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource POS.ListBoxItem.Default}"/>

    <Style x:Key="POS.ListView.Item"
           TargetType="ListViewItem"
           BasedOn="{StaticResource POS.ListBoxItem.Default}"/>

    <Style x:Key="POS.ListView.Default"
           TargetType="ListView"
           BasedOn="{StaticResource POS.ListBox.Default}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource POS.ListView.Item}"/>
    </Style>

    <Style x:Key="POS.Badge.Default"
           TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.2}"/>
        <Setter Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BadgeBase"
           TargetType="Border"
           BasedOn="{StaticResource POS.Badge.Default}"/>

    <Style x:Key="POS.Badge.Text"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Sm}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BadgeText"
           TargetType="TextBlock"
           BasedOn="{StaticResource POS.Badge.Text}"/>

    <Style x:Key="POS.Badge.Payment"
           TargetType="Border"
           BasedOn="{StaticResource POS.Badge.Default}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Default}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Cash">
                <Setter Property="Background" Value="{StaticResource Color.Success.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Color.Success.Border}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Card">
                <Setter Property="Background" Value="{StaticResource Color.Info.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Color.Info.Border}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="POS.Badge.PaymentText"
           TargetType="TextBlock"
           BasedOn="{StaticResource POS.Badge.Text}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Cash">
                <Setter Property="Foreground" Value="{StaticResource Color.Success.Default}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Card">
                <Setter Property="Foreground" Value="{StaticResource Color.Info.Default}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="POS.Badge.Status"
           TargetType="Border"
           BasedOn="{StaticResource POS.Badge.Default}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Default}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Completed">
                <Setter Property="Background" Value="{StaticResource Color.Info.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Color.Info.Border}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Voided">
                <Setter Property="Background" Value="{StaticResource Color.Danger.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Color.Danger.Border}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Pending">
                <Setter Property="Background" Value="{StaticResource Color.Warning.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Color.Warning.Border}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="POS.Badge.StatusText"
           TargetType="TextBlock"
           BasedOn="{StaticResource POS.Badge.Text}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Completed">
                <Setter Property="Foreground" Value="{StaticResource Color.Info.Default}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Voided">
                <Setter Property="Foreground" Value="{StaticResource Color.Danger.Default}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Pending">
                <Setter Property="Foreground" Value="{StaticResource Color.Warning.Default}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="POS.Badge.ShiftStatus"
           TargetType="Border"
           BasedOn="{StaticResource POS.Badge.Status}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Open">
                <Setter Property="Background" Value="{StaticResource Color.Success.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Color.Success.Border}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Closed">
                <Setter Property="Background" Value="{StaticResource Color.Info.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Color.Info.Border}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="POS.Badge.ShiftStatusText"
           TargetType="TextBlock"
           BasedOn="{StaticResource POS.Badge.StatusText}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Open">
                <Setter Property="Foreground" Value="{StaticResource Color.Success.Default}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Closed">
                <Setter Property="Foreground" Value="{StaticResource Color.Info.Default}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="POS.CurrencyText.Muted"
           TargetType="controls:CurrencyText"
           >
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Muted}"/>
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}"/>
    </Style>

    <Style x:Key="POS.Chip.Default"
           TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.3}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Brand.Dark}"/>
        <Setter Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.CoolSoft}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Border.Brand}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Brand.Selection}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Brand.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Text.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterChip"
           TargetType="ToggleButton"
           BasedOn="{StaticResource POS.Chip.Default}"/>
</ResourceDictionary>
