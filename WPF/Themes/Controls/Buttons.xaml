                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

