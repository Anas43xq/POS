<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Style x:Key="POS.TextBox.Default"
           TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Height" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.HeaderInline}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Md}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="Background" Value="{StaticResource Color.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Brand}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource Color.Brand.Dark}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Default}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Stretch"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Brand.Light}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.CoolSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Text.Disabled}"/>
                            <Setter Property="CaretBrush" Value="{StaticResource Color.Text.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter Property="Height" Value="{x:Static sys:Double.NaN}"/>
                            <Setter Property="Padding" Value="{StaticResource Spacing.2}"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldTextBox"
           TargetType="TextBox"
           BasedOn="{StaticResource POS.TextBox.Default}"/>

    <Style x:Key="POS.TextBox.Multiline"
           TargetType="TextBox"
           BasedOn="{StaticResource POS.TextBox.Default}">
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Height" Value="{x:Static sys:Double.NaN}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.2}"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>

    <Style x:Key="POS.TextBox.Borderless"
           TargetType="TextBox"
           BasedOn="{StaticResource POS.TextBox.Default}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="POS.TextBox.Search"
           TargetType="TextBox"
           BasedOn="{StaticResource POS.TextBox.Default}"/>

    <Style x:Key="POS.TextBox.SearchInline"
           TargetType="TextBox"
           BasedOn="{StaticResource POS.TextBox.Borderless}"/>

    <Style x:Key="POS.Input.BorderlessTextBox"
           TargetType="TextBox"
           BasedOn="{StaticResource POS.TextBox.Borderless}"/>

    <Style x:Key="FieldTextBoxBorderless"
           TargetType="TextBox"
           BasedOn="{StaticResource POS.TextBox.Borderless}"/>

    <Style x:Key="POS.PasswordBox.Default"
           TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Height" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.HeaderInline}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Md}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="Background" Value="{StaticResource Color.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Brand}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource Color.Brand.Dark}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Default}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Stretch"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Brand.Light}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.CoolSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Text.Disabled}"/>
                            <Setter Property="CaretBrush" Value="{StaticResource Color.Text.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldPasswordBox"
           TargetType="PasswordBox"
           BasedOn="{StaticResource POS.PasswordBox.Default}"/>

    <Style x:Key="POS.ComboBox.Default"
           TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Height" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.HeaderInline}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Md}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="Background" Value="{StaticResource Color.Surface.Default}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Brand}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Default}"/>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              RecognizesAccessKey="True"/>

                            <Path Grid.Column="1"
                                  Margin="{StaticResource Spacing.2}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Fill="{TemplateBinding Foreground}"
                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                        </Grid>

                        <ToggleButton x:Name="DropDownToggle"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{StaticResource Color.Surface.Default}"
                                    BorderBrush="{StaticResource Color.Border.Brand}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Margin="{StaticResource Spacing.1}"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer MaxHeight="220">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Brand.Light}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.CoolSoft}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Brand.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Color.Surface.Subtle}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Text.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldComboBox"
           TargetType="ComboBox"
           BasedOn="{StaticResource POS.ComboBox.Default}"/>

    <Style x:Key="POS.ComboBox.Item"
           TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Height" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.HeaderInline}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Md}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="Background" Value="{StaticResource Color.Surface.Default}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Brand.Light}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Color.Brand.Selection}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldComboBoxItem"
           TargetType="ComboBoxItem"
           BasedOn="{StaticResource POS.ComboBox.Item}"/>

    <Style x:Key="POS.DatePicker.Default"
           TargetType="DatePicker">
        <Setter Property="MinHeight" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Height" Value="{StaticResource Size.TouchTarget.Min}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.HeaderInline}"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Sm}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
        <Setter Property="Background" Value="{StaticResource Color.Brand.Light}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Brand}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style x:Key="DateInput"
           TargetType="DatePicker"
           BasedOn="{StaticResource POS.DatePicker.Default}"/>
</ResourceDictionary>
