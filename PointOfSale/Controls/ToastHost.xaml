<UserControl x:Class="UI.Controls.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:UI.Converters"
             xmlns:services="clr-namespace:UI.Services"
             mc:Ignorable="d"
             IsHitTestVisible="True"
             Focusable="False">

    <UserControl.Resources>
        <conv:ToastTypeToBrushConverter x:Key="ToastTypeToBrushConverter"/>
    </UserControl.Resources>

    <!--
        Anchored top-right, non-modal, stacked newest-on-bottom. Placed as
        an overlay over the main content (see MainWindow.xaml) so it
        floats above whatever screen is currently active.
    -->
    <ItemsControl ItemsSource="{Binding Toasts}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,16,16,0"
                  Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type services:ToastMessage}">
                <Border Background="{Binding Type, Converter={StaticResource ToastTypeToBrushConverter}, ConverterParameter=Light}"
                        BorderBrush="{Binding Type, Converter={StaticResource ToastTypeToBrushConverter}, ConverterParameter=Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,8"
                        MinWidth="260"
                        MaxWidth="360">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F2A4A" Opacity="0.18" BlurRadius="16" ShadowDepth="3" Direction="270"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Color accent bar -->
                        <Border Grid.Column="0"
                                Width="4"
                                Margin="0,0,10,0"
                                CornerRadius="2"
                                Background="{Binding Type, Converter={StaticResource ToastTypeToBrushConverter}, ConverterParameter=Accent}"
                                VerticalAlignment="Stretch"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Message}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{Binding Type, Converter={StaticResource ToastTypeToBrushConverter}, ConverterParameter=Dark}"/>

                        <Button Grid.Column="2"
                                Content="✕"
                                Padding="4"
                                Margin="8,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                VerticalAlignment="Top"
                                Foreground="{Binding Type, Converter={StaticResource ToastTypeToBrushConverter}, ConverterParameter=Dark}"
                                Click="OnDismissClick"
                                Tag="{Binding}"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
