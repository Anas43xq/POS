<!--
    Modifier Group Management — Master-Detail View
    Left: searchable group list | Right: group detail + options
-->
<UserControl x:Class="UI.Views.Modifiers.ModifierGroupManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="820">

    <UserControl.Resources>
        <!-- ── Palette ── -->
        <SolidColorBrush x:Key="BrandDark"    Color="#1A6FC4"/>
        <SolidColorBrush x:Key="BrandMid"     Color="#2589E0"/>
        <SolidColorBrush x:Key="BrandLight"   Color="#F0F7FF"/>
        <SolidColorBrush x:Key="BrandBorder"  Color="#B8D8F5"/>
        <SolidColorBrush x:Key="CardBg"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextDark"     Color="#1A3A5C"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#8AB0CC"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#16A34A"/>
        <SolidColorBrush x:Key="DangerRed"    Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerHover"  Color="#EF4444"/>

        <!-- Primary button -->
        <Style x:Key="PrimaryToolBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A6FC4" Offset="0"/>
                                    <GradientStop Color="#2589E0" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline button -->
        <Style x:Key="OutlineToolBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource BrandDark}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Background="{StaticResource BrandLight}" BorderBrush="{StaticResource BrandBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#DBEEFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button -->
        <Style x:Key="DangerToolBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource DangerRed}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FECACA"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#EAF4FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Page header -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Body -->
        </Grid.RowDefinitions>

        <!-- ═══ PAGE HEADER ═══ -->
        <TextBlock Grid.Row="0"
                   Text="Modifier Groups"
                   FontSize="18" FontWeight="Medium"
                   Foreground="{StaticResource TextDark}"
                   VerticalAlignment="Center" Margin="0,0,0,10"/>

        <!-- ═══ TOOLBAR ═══ -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BrandBorder}" BorderThickness="0.5"
                CornerRadius="10" Padding="12,9" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryToolBtn}" Margin="0,0,6,0" Command="{Binding AddGroupCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋  " FontSize="13" Foreground="White"/>
                            <TextBlock Text="Add Group" FontSize="12" FontWeight="Medium" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineToolBtn}" Margin="0,0,6,0" IsEnabled="{Binding HasSelection}" Command="{Binding EditGroupCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏  " FontSize="12"/>
                            <TextBlock Text="Edit" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerToolBtn}" Margin="0,0,6,0" IsEnabled="{Binding HasSelection}" Command="{Binding DeleteGroupCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑  " FontSize="12" Foreground="{StaticResource DangerRed}"/>
                            <TextBlock Text="Delete" FontSize="12" Foreground="{StaticResource DangerRed}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineToolBtn}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄  " FontSize="12"/>
                            <TextBlock Text="Refresh" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- Search -->
                <Border Grid.Column="2" Background="{StaticResource BrandLight}" BorderBrush="{StaticResource BrandBorder}"
                        BorderThickness="1" CornerRadius="7" Height="32" Width="220">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="12"
                                 Foreground="{StaticResource TextDark}" VerticalContentAlignment="Center" Padding="0,0,8,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ BODY ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>  <!-- Group list -->
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>    <!-- Detail -->
            </Grid.ColumnDefinitions>

            <!-- ─── GROUP LIST (Left Panel) ─── -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BrandBorder}" BorderThickness="0.5"
                    CornerRadius="10" Padding="12">
                <ListBox ItemsSource="{Binding Groups}"
                         SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,0,0,2" CornerRadius="6"
                                    BorderBrush="{StaticResource BrandBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextDark}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding GroupTypeDisplay}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}">
                                            <Run Text="{Binding OptionCount, Mode=OneWay}"/>
                                            <Run Text=" options"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DBEEFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- ─── DETAIL (Right Panel) ─── -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BrandBorder}" BorderThickness="0.5"
                    CornerRadius="10" Padding="16,14"
                    Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Error banner -->
                        <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="7"
                                Padding="12,10" Margin="0,0,0,10"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" FontWeight="Medium" Foreground="#991B1B" TextWrapping="Wrap"/>
                        </Border>

                        <!-- ═══ GROUP GENERAL INFO (read mode) ═══ -->
                        <TextBlock Text="GROUP INFORMATION" FontSize="10" FontWeight="Medium" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

                        <!-- ═══ GROUP EDIT FORM ═══ -->
                        <Border Background="{StaticResource BrandLight}" BorderBrush="{StaticResource BrandBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12"
                                Visibility="{Binding IsEditingGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Group Details" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,10"/>

                                <!-- Name -->
                                <TextBlock Text="Name" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditGroupName, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" Margin="0,0,0,10"/>

                                <!-- Group Type -->
                                <TextBlock Text="Selection Type" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding EditGroupType}" SelectedValuePath="Value"
                                          DisplayMemberPath="Value" ItemsSource="{Binding GroupTypeOptions}" Margin="0,0,0,10"/>

                                <!-- Required + Active -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox Content="Required" IsChecked="{Binding EditIsRequired}" Margin="0,0,16,0" FontSize="12"/>
                                    <CheckBox Content="Active" IsChecked="{Binding EditIsActive}" FontSize="12"/>
                                </StackPanel>

                                <!-- Min / Max -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Min Selections" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditMinSelections, UpdateSourceTrigger=PropertyChanged}" Width="80" FontSize="13" Padding="8,6"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Max Selections" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditMaxSelections, UpdateSourceTrigger=PropertyChanged}" Width="80" FontSize="13" Padding="8,6"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Display Order" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditSortOrder, UpdateSourceTrigger=PropertyChanged}" Width="80" FontSize="13" Padding="8,6"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Save / Cancel -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryToolBtn}" Content="Save" Command="{Binding SaveGroupCommand}" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource OutlineToolBtn}" Content="Cancel" Command="{Binding CancelGroupEditCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ═══ MODIFIER OPTIONS ═══ -->
                        <Border BorderBrush="{StaticResource BrandBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MODIFIER OPTIONS" FontSize="10" FontWeight="Medium" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryToolBtn}" Command="{Binding AddOptionCommand}" Height="28" Padding="10,0">
                                    <TextBlock Text="＋ Add Option" FontSize="11" Foreground="White"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Options DataGrid -->
                        <DataGrid ItemsSource="{Binding Options}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserResizeRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}" Margin="0,0,0,10"
                                  HeadersVisibility="Column" AlternatingRowBackground="#F9FBFF" GridLinesVisibility="Horizontal"
                                  MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Option Name" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding PriceAdd, StringFormat=0.00}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault}" Width="70"/>
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                                <DataGridTextColumn Header="Order" Binding="{Binding SortOrder}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Option action buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Style="{StaticResource OutlineToolBtn}" Margin="0,0,6,0" IsEnabled="{Binding HasOptionSelection}" Command="{Binding EditOptionCommand}">
                                <TextBlock Text="✏ Edit Option" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource DangerToolBtn}" IsEnabled="{Binding HasOptionSelection}" Command="{Binding DeleteOptionCommand}">
                                <TextBlock Text="🗑 Delete Option" FontSize="11"/>
                            </Button>
                        </StackPanel>

                        <!-- ═══ OPTION EDIT FORM ═══ -->
                        <Border Background="{StaticResource BrandLight}" BorderBrush="{StaticResource BrandBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10"
                                Visibility="{Binding IsEditingOption, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Option Details" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,10"/>

                                <TextBlock Text="Name" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditOptionName, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Price Add" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditOptionPrice, UpdateSourceTrigger=PropertyChanged}" Width="100" FontSize="13" Padding="8,6"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Display Order" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditOptionSortOrder, UpdateSourceTrigger=PropertyChanged}" Width="80" FontSize="13" Padding="8,6"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox Content="Allow Quantity" IsChecked="{Binding EditOptionAllowQuantity}" Margin="0,0,16,0" FontSize="12"/>
                                    <CheckBox Content="Default (Regular)" IsChecked="{Binding EditOptionIsDefault}" Margin="0,0,16,0" FontSize="12"/>
                                    <CheckBox Content="Active" IsChecked="{Binding EditOptionIsActive}" FontSize="12"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryToolBtn}" Content="Save Option" Command="{Binding SaveOptionCommand}" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource OutlineToolBtn}" Content="Cancel" Command="{Binding CancelOptionEditCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Empty state when no group selected -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BrandBorder}" BorderThickness="0.5"
                    CornerRadius="10" Padding="16"
                    Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Visible}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Select a modifier group to view its details" FontSize="14" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>