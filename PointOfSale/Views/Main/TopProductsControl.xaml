<!--
    ╔══════════════════════════════════════════════════════╗
    ║   Top Products list. Header/row share one column      ║
    ║   layout so text always starts at the same X.          ║
    ║   Product = left, Sales = right (currency exception).  ║
    ╚══════════════════════════════════════════════════════╝
-->
<UserControl x:Class="UI.Views.TopProductsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="360" d:DesignWidth="380">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/AppChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ColLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            </Style>
            <Style x:Key="ListRow" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BrandLight}"/>
                <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
                <Setter Property="Padding" Value="0,6"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardHeaderBorder}">
                <TextBlock Style="{StaticResource CardTitle}">
                    <Run Text="🏆  "/>
                    <Run Text="{DynamicResource Manager.Home.TopProducts}"/>
                </TextBlock>
            </Border>

            <Grid Grid.Row="1" Margin="12,6,12,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Manager.Home.ColProduct}" Style="{StaticResource ColLabel}"/>
                <TextBlock Grid.Column="1" Text="{DynamicResource Manager.Home.ColSales}" Style="{StaticResource ColLabel}"
                           TextAlignment="Right"/>
            </Grid>
            <Border Grid.Row="1" BorderBrush="#E8F3FF" BorderThickness="0,0,0,0.5"
                    Margin="12,26,12,0" VerticalAlignment="Top"/>

            <ScrollViewer Grid.Row="2" Padding="12,4,12,8" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TopProducts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ProductName}"
                                               FontSize="11" FontWeight="Medium"
                                               Foreground="{StaticResource TextDark}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TotalSales, StringFormat={}{0:C}}"
                                               FontSize="11" FontWeight="Medium"
                                               Foreground="{StaticResource SuccessGreen}"
                                               TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
