<!--
    ╔══════════════════════════════════════════════════════╗
    ║   Reusable Manager filter bar: quick-range chips +    ║
    ║   custom period + refresh. No DataContext of its own  ║
    ║   — inherits whatever VM the host view is using.      ║
    ╚══════════════════════════════════════════════════════╝
-->
<UserControl x:Class="UI.Views.FilterPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="46" d:DesignWidth="1225">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/AppChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="{StaticResource BrandBorder}"
            BorderThickness="0.5"
            CornerRadius="10"
            Padding="12,9">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                <RadioButton Style="{StaticResource FilterChip}" Content="{DynamicResource Common.Today}" IsChecked="True"
                             Command="{Binding FilterTodayCommand}"/>
                <RadioButton Style="{StaticResource FilterChip}" Content="{DynamicResource Common.ThisWeek}"
                             Command="{Binding FilterThisWeekCommand}"/>
                <RadioButton Style="{StaticResource FilterChip}" Content="{DynamicResource Common.ThisMonth}"
                             Command="{Binding FilterMonthCommand}"/>
                <RadioButton Style="{StaticResource FilterChip}" Content="{DynamicResource Common.Period}"
                             Command="{Binding ShowPeriodFilterCommand}"/>

                <Border Width="1" Height="20" Background="{StaticResource BrandBorder}" Margin="6,0"/>

                <TextBlock Text="{DynamicResource Common.From}" FontSize="11" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker Style="{StaticResource DateInput}"
                            SelectedDate="{Binding PeriodFromDate}"
                            Margin="0,0,12,0"/>

                <TextBlock Text="{DynamicResource Common.To}" FontSize="11" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker Style="{StaticResource DateInput}"
                            SelectedDate="{Binding PeriodToDate}"
                            Margin="0,0,12,0"/>

                <Button Style="{StaticResource ApplyBtn}"
                        Content="{DynamicResource Common.Apply}"
                        Command="{Binding ApplyPeriodFilterCommand}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource OutlineBtn}"
                    Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="🔄 "/>
                    <Run Text="{DynamicResource Common.Refresh}"/>
                </TextBlock>
            </Button>
        </Grid>
    </Border>
</UserControl>
