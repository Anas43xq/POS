<UserControl x:Class="UI.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UI.Controls"
             Background="#F5F6FA">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- 1. HEADER + FILTER SECTION                                   -->
        <!-- ============================================================ -->
        <Border Background="#FFFFFF"
                Padding="14"
                CornerRadius="6">
            <StackPanel>
                <!-- Title + Mode Toggle + Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource Manager.Reports.Title}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               VerticalAlignment="Center"/>

                    <!-- Report Mode Toggle + Action Buttons -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <RadioButton Content="{DynamicResource Manager.Reports.SalesMode}"
                                     GroupName="ReportMode"
                                     IsChecked="{Binding IsSalesMode}"
                                     Margin="0,0,12,0"
                                     FontSize="13"
                                     Foreground="#555555"/>
                        <RadioButton Content="{DynamicResource Manager.Reports.ProductMode}"
                                     GroupName="ReportMode"
                                     IsChecked="{Binding IsProductMode}"
                                     Margin="0,0,16,0"
                                     FontSize="13"
                                     Foreground="#555555"/>

                        <Button Content="{DynamicResource Manager.Reports.GenerateExport}"
                                Style="{StaticResource PrimaryGradientBtn}"
                                Command="{Binding ReportCommand}"
                                CommandParameter="GenerateAndExport"
                                Padding="14,6"/>
                    </StackPanel>
                </Grid>

                <!-- Filter Period Buttons -->
                <Border BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!-- Shared date-range mechanism: Today / This Week /
                                 This Month / Period chips + From / To / Apply. -->
                            <controls:DateRangeFilterControl
                                DayCommand="{Binding FilterTodayCommand}"
                                WeekCommand="{Binding FilterThisWeekCommand}"
                                MonthCommand="{Binding FilterMonthCommand}"
                                PeriodCommand="{Binding ShowPeriodFilterCommand}"
                                ApplyCommand="{Binding ApplyPeriodFilterCommand}"
                                IsPeriodFilterVisible="{Binding IsPeriodFilterVisible}"
                                FromDate="{Binding FromDate, Mode=TwoWay}"
                                ToDate="{Binding ToDate, Mode=TwoWay}"
                                DayLabel="{DynamicResource Common.Today}"
                                WeekLabel="{DynamicResource Common.ThisWeek}"
                                MonthLabel="{DynamicResource Common.ThisMonth}"
                                PeriodLabel="{DynamicResource Common.Period}"
                                FromLabel="{DynamicResource Common.From}"
                                ToLabel="{DynamicResource Common.To}"
                                ApplyButtonText="{DynamicResource Common.Apply}"
                                Margin="0,0,0,0"/>

                            <!-- Product ComboBox (only visible in Product Mode) -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ProductGridVisibility}"
                                        Margin="12,0,0,0">
                                <TextBlock Text="{DynamicResource Manager.Reports.ProductLabel}" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="#6B7280" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding Products}"
                                          SelectedItem="{Binding SelectedProduct}"
                                          Width="140"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- 2. MAIN CONTENT (SUMMARY + DATA GRID)                        -->
        <!-- ============================================================ -->
        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Background="#FFFFFF"
                Padding="14"
                CornerRadius="6"
                BorderBrush="#E0E0E0"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ============================================================ -->
                <!-- SUMMARY SECTION (CARD STYLE - SALES MODE)                    -->
                <!-- ============================================================ -->
                <Border BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14"
                        Margin="0,0,0,12"
                        Visibility="{Binding SalesSummaryVisibility}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="#EEF2FF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="4"
                                Background="#F8FAFF">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.TotalOrders}"
                                           FontSize="11"
                                           Foreground="#6B7280"/>
                                <TextBlock Text="{Binding TotalOrders}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#333333"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                BorderBrush="#EEF2FF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="4"
                                Background="#F8FAFF">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.TotalSales}"
                                           FontSize="11"
                                           Foreground="#6B7280"/>
                                <TextBlock Text="{Binding TotalSales}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#333333"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                BorderBrush="#EEF2FF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="4"
                                Background="#F8FAFF">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.CashTotal}"
                                           FontSize="11"
                                           Foreground="#6B7280"/>
                                <TextBlock Text="{Binding CashTotal}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#333333"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3"
                                BorderBrush="#EEF2FF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="4"
                                Background="#F8FAFF">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.CardTotal}"
                                           FontSize="11"
                                           Foreground="#6B7280"/>
                                <TextBlock Text="{Binding CardTotal}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#333333"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============================================================ -->
                <!-- SUMMARY SECTION (CARD STYLE - PRODUCT MODE)                  -->
                <!-- ============================================================ -->
                <Border BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14"
                        Margin="0,0,0,12"
                        Visibility="{Binding ProductSummaryVisibility}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="#EEF2FF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="4"
                                Background="#F8FAFF">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.TotalQuantitySold}"
                                           FontSize="11"
                                           Foreground="#6B7280"/>
                                <TextBlock Text="{Binding TotalQuantitySold}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#333333"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                BorderBrush="#EEF2FF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="4"
                                Background="#F8FAFF">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.TotalRevenue}"
                                           FontSize="11"
                                           Foreground="#6B7280"/>
                                <TextBlock Text="{Binding TotalRevenue}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#333333"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                BorderBrush="#EEF2FF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="4"
                                Background="#F8FAFF">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.AveragePrice}"
                                           FontSize="11"
                                           Foreground="#6B7280"/>
                                <TextBlock Text="{Binding AveragePrice}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#333333"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============================================================ -->
                <!-- DATA GRID - SALES MODE                                       -->
                <!-- ============================================================ -->
                <DataGrid Grid.Row="1"
                          Style="{StaticResource ManagerDataGrid}"
                          ItemsSource="{Binding TransactionReports}"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1"
                          RowHeaderWidth="0"
                          FontSize="13"
                          Visibility="{Binding SalesGridVisibility}">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Reports.ColReceiptNumber}"
                                                Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ReceiptNumber}"
                                            FontSize="13"
                                            Cursor="Hand"
                                            HorizontalAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Foreground="#1A6FC4"
                                            Command="{Binding DataContext.OpenReceiptCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#DBEEFF" CornerRadius="4" Padding="7,2">
                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColDateTime}"
                                            Binding="{Binding TransactionDate, StringFormat={}{0:g}}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColPaymentMethod}"
                                            Binding="{Binding PaymentMethod}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColGrandTotal}"
                                            Binding="{Binding GrandTotal, StringFormat={}{0:N2}}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColNote}"
                                            Binding="{Binding Note}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ============================================================ -->
                <!-- DATA GRID - PRODUCT MODE                                     -->
                <!-- ============================================================ -->
                <DataGrid Grid.Row="1"
                          Style="{StaticResource ManagerDataGrid}"
                          ItemsSource="{Binding ProductReports}"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1"
                          RowHeaderWidth="0"
                          FontSize="13"
                          Visibility="{Binding ProductGridVisibility}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColReceiptNumber}"
                                            Binding="{Binding ReceiptNumber}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColDateTime}"
                                            Binding="{Binding TransactionDate, StringFormat={}{0:g}}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColPaymentMethod}"
                                            Binding="{Binding PaymentMethod}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColQuantity}"
                                            Binding="{Binding Quantity}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColLineTotal}"
                                            Binding="{Binding LineTotal, StringFormat={}{0:N2}}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>

    </Grid>
</UserControl>
