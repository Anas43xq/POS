<!--
    ╔══════════════════════════════════════════════════════╗
    ║   Cafeteria Hawa POS  –  Manager · Reports            ║
    ║   Filter bar + mode-dependent KPI strip + dedicated   ║
    ║   Sales DataGrid.                                      ║
    ║                                                       ║
    ║   The filter bar lives in its own UserControl          ║
    ║   (<views:ReportFilterPanelControl/>) so the same      ║
    ║   panel adapts to both report modes instead of two     ║
    ║   near-duplicate panels. The grid reuses the same      ║
    ║   ManagerDataGrid chrome as Transactions/Shifts so all  ║
    ║   list screens stay visually consistent.                ║
    ╚══════════════════════════════════════════════════════╝
-->
<UserControl x:Class="UI.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             xmlns:views="clr-namespace:UI.Views"
             mc:Ignorable="d"
             d:DesignWidth="1420" d:DesignHeight="860">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- BadgeBase/BadgeText live in AppChrome.xaml, which isn't
                     part of the global App.xaml merge. -->
                <ResourceDictionary Source="/Resources/AppChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Payment badge border (used inside both DataGrids' cell templates) -->
            <Style x:Key="ReportPaymentBadgeBorderStyle" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PaymentMethod}" Value="Cash">
                        <Setter Property="Background" Value="{StaticResource SuccessLight}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PaymentMethod}" Value="Card">
                        <Setter Property="Background" Value="#DBEAFE"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Payment badge text -->
            <Style x:Key="ReportPaymentBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PaymentMethod}" Value="Cash">
                        <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PaymentMethod}" Value="Card">
                        <Setter Property="Foreground" Value="{StaticResource BrandDark}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#EAF4FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Filter bar -->
            <RowDefinition Height="Auto"/>
            <!-- KPI strip (mode-dependent) -->
            <RowDefinition Height="*"/>
            <!-- Report table card -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════
             FILTER BAR
             ══════════════════════════════════════ -->
        <views:ReportFilterPanelControl Grid.Row="0" Margin="0,0,0,10"/>

        <!-- ══════════════════════════════════════
             KPI STRIP — one card per mode, toggled by
             the existing SalesSummaryVisibility /
             SalesAnalysisSummaryVisibility bindings. Tiles
             reuse the same DashboardKpiTile style as
             HomeView's KpiMetricsControl.
             ══════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,10">

            <!-- Sales KPIs -->
            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding SalesSummaryVisibility}">
                <StackPanel>
                    <Border Style="{StaticResource CardHeaderBorder}">
                        <TextBlock Style="{StaticResource CardTitle}">
                            <Run Text="📊  "/>
                            <Run Text="{DynamicResource Manager.Reports.SalesMode}"/>
                        </TextBlock>
                    </Border>

                    <UniformGrid Columns="4" Margin="12,10,12,12">
                        <Border Style="{StaticResource DashboardKpiTile}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.TotalSales}"
                                           Style="{StaticResource DashboardKpiLabel}"/>
                                <TextBlock Text="{Binding TotalSales}"
                                           Style="{StaticResource DashboardKpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardKpiTile}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.TotalOrders}"
                                           Style="{StaticResource DashboardKpiLabel}"/>
                                <TextBlock Text="{Binding TotalOrders}"
                                           Style="{StaticResource DashboardKpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardKpiTile}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.CashTotal}"
                                           Style="{StaticResource DashboardKpiLabel}"/>
                                <TextBlock Text="{Binding CashTotal}"
                                           Style="{StaticResource DashboardKpiValue}"
                                           Foreground="{StaticResource SuccessGreen}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardKpiTile}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.CardTotal}"
                                           Style="{StaticResource DashboardKpiLabel}"/>
                                <TextBlock Text="{Binding CardTotal}"
                                           Style="{StaticResource DashboardKpiValue}"
                                           Foreground="{StaticResource BrandDark}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Sales Analysis KPIs -->
            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding SalesAnalysisSummaryVisibility}">
                <StackPanel>
                    <Border Style="{StaticResource CardHeaderBorder}">
                        <TextBlock Style="{StaticResource CardTitle}">
                            <Run Text="🧾  "/>
                            <Run Text="{DynamicResource Manager.Reports.SalesAnalysisMode}"/>
                        </TextBlock>
                    </Border>

                    <UniformGrid Columns="5" Margin="12,10,12,12">
                        <Border Style="{StaticResource DashboardKpiTile}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.CategoriesSold}"
                                           Style="{StaticResource DashboardKpiLabel}"/>
                                <TextBlock Text="{Binding CategoriesSold}"
                                           Style="{StaticResource DashboardKpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardKpiTile}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.ProductsSold}"
                                           Style="{StaticResource DashboardKpiLabel}"/>
                                <TextBlock Text="{Binding ProductsSold}"
                                           Style="{StaticResource DashboardKpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardKpiTile}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.VariantsSold}"
                                           Style="{StaticResource DashboardKpiLabel}"/>
                                <TextBlock Text="{Binding VariantsSold}"
                                           Style="{StaticResource DashboardKpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardKpiTile}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.TotalQuantitySold}"
                                           Style="{StaticResource DashboardKpiLabel}"/>
                                <TextBlock Text="{Binding SalesAnalysisTotalQuantitySold}"
                                           Style="{StaticResource DashboardKpiValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardKpiTile}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Manager.Reports.TotalSales}"
                                           Style="{StaticResource DashboardKpiLabel}"/>
                                <TextBlock Text="{Binding SalesAnalysisTotalSales}"
                                           Style="{StaticResource DashboardKpiValue}"
                                           Foreground="{StaticResource BrandDark}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════
             REPORT TABLE CARD — one DataGrid per mode,
             each focused on its own dataset instead of
             one grid forcing two layouts together.
             ══════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- header -->
                    <RowDefinition Height="*"/>
                    <!-- grid   -->
                </Grid.RowDefinitions>

                <!-- Card header -->
                <Border Grid.Row="0" Style="{StaticResource CardHeaderBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Manager.Reports.Title}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource Common.Loading}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════
                     DATA GRID — SALES MODE
                     ═══════════════════════════════ -->
                <DataGrid Grid.Row="1"
                          Style="{StaticResource ManagerDataGrid}"
                          ItemsSource="{Binding TransactionReports}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Visibility="{Binding SalesGridVisibility}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Reports.ColReceiptNumber}" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ReceiptNumber}"
                                            FontSize="11"
                                            Cursor="Hand"
                                            HorizontalAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Foreground="{StaticResource BrandDark}"
                                            Command="{Binding DataContext.OpenReceiptCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="{StaticResource BrandLight}" CornerRadius="4" Padding="8,2">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrandBorder}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColDateTime}"
                                            Binding="{Binding TransactionDate, StringFormat='yyyy-MM-dd HH:mm'}"
                                            Width="160"/>
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Reports.ColPaymentMethod}" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Style="{StaticResource ReportPaymentBadgeBorderStyle}">
                                        <TextBlock Text="{Binding PaymentMethod}"
                                                   Style="{StaticResource ReportPaymentBadgeTextStyle}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Reports.ColGrandTotal}" Width="120">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagerDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CurrencyText Amount="{Binding GrandTotal}"
                                                           Foreground="{StaticResource TextDark}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColNote}"
                                            Binding="{Binding Note}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ═══════════════════════════════
                     DATA GRID — SALES ANALYSIS MODE
                     Flat Category/Product/Size rows on
                     screen; the Category -> Product -> Size
                     hierarchy with outline grouping is built
                     during Excel export (see ExcelReportExporter).
                     ═══════════════════════════════ -->
                <DataGrid Grid.Row="1"
                          Style="{StaticResource ManagerDataGrid}"
                          ItemsSource="{Binding SalesAnalysisReports}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Visibility="{Binding SalesAnalysisGridVisibility}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColCategory}"
                                            Binding="{Binding CategoryName}"
                                            Width="180"/>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColProduct}"
                                            Binding="{Binding ProductName}"
                                            Width="220"/>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColSize}"
                                            Binding="{Binding SizeName}"
                                            Width="120"/>
                        <DataGridTextColumn Header="{DynamicResource Manager.Reports.ColQuantity}"
                                            Binding="{Binding Quantity}"
                                            Width="100"/>
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Reports.ColLineTotal}" Width="*">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagerDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CurrencyText Amount="{Binding LineTotal}"
                                                           Foreground="{StaticResource TextDark}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
