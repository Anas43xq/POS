<!--
    ╔══════════════════════════════════════════════════════╗
    ║   Reports filter bar. One adaptive panel for both     ║
    ║   report modes — avoids two near-identical filter      ║
    ║   panels. Top row: Sales/Product segmented toggle +    ║
    ║   Generate/Export action. Bottom row: the shared        ║
    ║   <controls:DateRangeFilterControl/> (same mechanism   ║
    ║   as Home/Transactions/Shifts) plus the Product combo, ║
    ║   which only appears in Product mode.                  ║
    ║   No DataContext of its own — inherits the host VM.    ║
    ╚══════════════════════════════════════════════════════╝
-->
<UserControl x:Class="UI.Views.ReportFilterPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             mc:Ignorable="d" d:DesignHeight="90" d:DesignWidth="1420">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/AppChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Same visual language as DateInput (height/border/radius),
                 just for the Product ComboBox. -->
            <Style x:Key="ProductFilterCombo" TargetType="ComboBox">
                <Setter Property="Width" Value="160"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{StaticResource BrandLight}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrandBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource FilterPanel}">
        <StackPanel>

            <!-- ══════════════════════════════════════
                 ROW 1 — Mode toggle + Generate/Export
                 ══════════════════════════════════════ -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Segmented Sales / Product toggle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource FilterChip}"
                                 GroupName="ReportMode"
                                 Content="{DynamicResource Manager.Reports.SalesMode}"
                                 IsChecked="{Binding IsSalesMode}"/>
                    <RadioButton Style="{StaticResource FilterChip}"
                                 GroupName="ReportMode"
                                 Content="{DynamicResource Manager.Reports.ProductMode}"
                                 IsChecked="{Binding IsProductMode}"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryGradientBtn}"
                        Content="{DynamicResource Manager.Reports.GenerateExport}"
                        Command="{Binding ReportCommand}"
                        CommandParameter="GenerateAndExport"
                        Padding="16,0"/>
            </Grid>

            <Border Height="0.5" Background="{StaticResource BrandBorder}" Margin="0,0,0,10"/>

            <!-- ══════════════════════════════════════
                 ROW 2 — Date range + Product selector
                 ══════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Shared date-range mechanism: Today / This Week /
                     This Month / Period chips + From / To / Apply.
                     Identical surface to Home/Transactions/Shifts. -->
                <controls:DateRangeFilterControl
                    DayCommand="{Binding FilterTodayCommand}"
                    WeekCommand="{Binding FilterThisWeekCommand}"
                    MonthCommand="{Binding FilterMonthCommand}"
                    PeriodCommand="{Binding ShowPeriodFilterCommand}"
                    ApplyCommand="{Binding ApplyPeriodFilterCommand}"
                    IsPeriodFilterVisible="{Binding IsPeriodFilterVisible}"
                    FromDate="{Binding FromDate, Mode=TwoWay}"
                    ToDate="{Binding ToDate, Mode=TwoWay}"
                    DayLabel="{DynamicResource Common.Today}"
                    WeekLabel="{DynamicResource Common.ThisWeek}"
                    MonthLabel="{DynamicResource Common.ThisMonth}"
                    PeriodLabel="{DynamicResource Common.Period}"
                    FromLabel="{DynamicResource Common.From}"
                    ToLabel="{DynamicResource Common.To}"
                    ApplyButtonText="{DynamicResource Common.Apply}"/>

                <!-- Product selector — only visible in Product mode.
                     Reuses ProductGridVisibility (already true only when
                     IsProductMode is true), no new VM surface needed. -->
                <Border Width="1" Height="20"
                        Background="{StaticResource BrandBorder}"
                        Margin="12,0,10,0"
                        Visibility="{Binding ProductGridVisibility}"/>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding ProductGridVisibility}">
                    <TextBlock Text="{DynamicResource Manager.Reports.ProductLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}"/>
                    <ComboBox Style="{StaticResource ProductFilterCombo}"
                              ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                              DisplayMemberPath="Name"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
