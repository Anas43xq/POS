<!--
    ╔══════════════════════════════════════════════════════╗
    ║   Cafeteria Hawa POS  –  Add / Edit Category Dialog  ║
    ║   Modal popup with overlay dismiss                   ║
    ╚══════════════════════════════════════════════════════╝
-->
<Window x:Class="UI.Views.AddEditCategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{DynamicResource Common.Category}"
        Width="440" Height="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="AddEditCategoryDialog_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- ── Field TextBox (no central equivalent — DialogChrome only styles the border) ── -->
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FontSize"                 Value="12.5"/>
            <Setter Property="Foreground"               Value="{StaticResource ModalTextDark}"/>
            <Setter Property="CaretBrush"                Value="{StaticResource ModalBrandDark}"/>
            <Setter Property="VerticalContentAlignment"  Value="Center"/>
            <Setter Property="Padding"                   Value="10,0"/>
            <Setter Property="FocusVisualStyle"          Value="{x:Null}"/>
        </Style>

        <!-- ── ComboBox (local — identical metrics to ProductFormView's version) ── -->
        <Style x:Key="FieldComboBox" TargetType="ComboBox">
            <Setter Property="Background"               Value="{StaticResource ModalBrandLight}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource ModalBrandBorder}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="FontSize"                 Value="12.5"/>
            <Setter Property="Foreground"               Value="{StaticResource ModalTextDark}"/>
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedItem.DisplayName,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                           VerticalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="{StaticResource ModalTextDark}"/>
                                <TextBlock Grid.Column="1"
                                           Text="▾"
                                           FontSize="10"
                                           Foreground="{StaticResource ModalBrandDark}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen,
                                          RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True">
                                <Border Background="White"
                                        BorderBrush="{StaticResource ModalBrandBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{StaticResource ModalBrandDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding"  Value="10,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource ModalTextDark}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" Foreground="{StaticResource ModalTextDark}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DBEEFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!--
         Semi-transparent overlay — clicking it closes the dialog (code-behind).
         The card is centered inside it.
    -->
    <Grid x:Name="OverlayGrid"
          Background="#55000000"
          MouseDown="OverlayGrid_MouseDown">

        <!-- Card — clicks here do NOT propagate to overlay -->
        <Border x:Name="DialogCard"
                Width="400"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Style="{StaticResource ModalCardBorder}"
                MouseDown="DialogCard_MouseDown">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header          -->
                    <RowDefinition Height="Auto"/>
                    <!-- Error           -->
                    <RowDefinition Height="*"/>
                    <!-- Fields          -->
                    <RowDefinition Height="Auto"/>
                    <!-- Footer          -->
                </Grid.RowDefinitions>

                <!-- ── Header ── -->
                <Border Grid.Row="0"
                        Style="{StaticResource ModalHeaderBorder}"
                        Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="7"
                                    Background="{StaticResource ModalBrandDark}"
                                    Margin="0,0,10,0">
                                <TextBlock Text="🏷" FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding DialogTitle, FallbackValue='Add Category'}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModalTextDark}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- ✕ close -->
                        <Button Grid.Column="1"
                                Content="✕"
                                FontSize="13"
                                Style="{StaticResource ModalCloseButton}"
                                Command="{Binding CancelCommand}"/>
                    </Grid>
                </Border>

                <!-- ── Validation error banner ── -->
                <Border Grid.Row="1"
                        Background="{StaticResource ModalErrorBg}"
                        BorderBrush="{StaticResource ModalErrorBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,9"
                        Margin="18,12,18,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠ " FontSize="13" Foreground="{StaticResource ModalErrorFg}"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource ModalErrorFg}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ── Fields ── -->
                <StackPanel Grid.Row="2" Margin="18,16,18,8">

                    <!-- Name -->
                    <TextBlock Text="{DynamicResource Common.Name}" Style="{StaticResource ModalLabel}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource ModalInputBorder}" Height="40" Margin="0,0,0,16">
                        <TextBox x:Name="NameBox"
                                 Style="{StaticResource FieldTextBox}"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                                 Color="#B8D8F5"/>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>

                    <!-- Parent Category -->
                    <TextBlock Text="{DynamicResource Manager.CategoryDialog.ParentCategoryLabel}" Style="{StaticResource ModalLabel}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource FieldComboBox}"
                              ItemsSource="{Binding ParentCategoryOptions}"
                              SelectedItem="{Binding SelectedParent}"
                              DisplayMemberPath="DisplayName"
                              Margin="0,0,0,5"/>
                    <TextBlock Text="{DynamicResource Manager.CategoryDialog.ParentCategoryHint}"
                               FontSize="10.5"
                               Foreground="{StaticResource ModalTextMuted}"
                               Margin="0,0,0,18"/>

                    <!-- Icon -->
                    <TextBlock Text="{DynamicResource Common.Icon}" Style="{StaticResource ModalLabel}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource ModalInputBorder}"
                                Width="56" Height="56">
                            <TextBox Style="{StaticResource FieldTextBox}"
                                     Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="2"
                                     TextAlignment="Center"
                                     Padding="0"
                                     FontSize="22">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                                     Color="#B8D8F5"/>
                                </TextBox.Resources>
                            </TextBox>
                        </Border>

                        <TextBlock Grid.Column="2"
                                   Text="A short emoji or symbol used to identify this category at a glance."
                                   FontSize="10.5"
                                   Foreground="{StaticResource ModalTextMuted}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>

                <!-- ── Footer ── -->
                <Border Grid.Row="3"
                        Style="{StaticResource ModalFooterBorder}"
                        Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource OutlineBtn}"
                                Content="🌐 Translations…"
                                Command="{Binding TranslationsCommand}"
                                HorizontalAlignment="Left"
                                Padding="14,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource OutlineBtn}"
                                    Content="{DynamicResource Common.Cancel}"
                                    Margin="0,0,10,0"
                                    Command="{Binding CancelCommand}"/>
                            <Button Style="{StaticResource PrimaryGradientBtn}"
                                    Content="{DynamicResource Common.Save}"
                                    Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
