<UserControl x:Class="UI.Views.Cashier.ErrorBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1600" d:DesignHeight="34">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CashierPalette.xaml"/>
                <ResourceDictionary Source="CashierControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

     <!--
         Row 0 in the shell is Height="Auto", so this collapses to 0 height
         automatically when Visibility="Collapsed".
         Fade-in animation plays when the error banner first becomes visible.
     -->
     <!-- HTML: .error-banner padding 7px 14px, bg #F5E4DF, border-bottom #E3C4B7 -->
     <Border x:Name="RootBorder"
             Background="#F5E4DF"
             BorderBrush="#E3C4B7"
             BorderThickness="0,0,0,1"
             Padding="14,7"
             Opacity="0"
             Visibility="{Binding HasHeaderError, Converter={StaticResource BoolToVisibilityConverter}}">
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootBorder"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1"
                                         Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="&#xE783;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="13"
                       Foreground="{StaticResource DangerRed}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

             <TextBlock Grid.Column="1"
                        Text="{Binding HeaderErrorMessage}"
                       FontSize="12" FontWeight="Medium"
                       Foreground="{StaticResource DangerRed}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="2"
                    Style="{StaticResource ModCloseBtn}"
                    Command="{Binding DismissErrorCommand}"
                    Content="&#xE711;"
                    FontFamily="Segoe MDL2 Assets"/>
        </Grid>
    </Border>
</UserControl>
