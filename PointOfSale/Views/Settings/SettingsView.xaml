<UserControl x:Class="UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="400" d:DesignHeight="600">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="{DynamicResource Settings.Title}"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#0F172A"
                           Margin="0,0,0,20"/>

                <!-- Language Selection -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="{DynamicResource Settings.Language}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,10"/>

                    <ListBox ItemsSource="{Binding SupportedLanguages}"
                             SelectedItem="{Binding SelectedLanguage}"
                             DisplayMemberPath="DisplayName"
                             FontSize="16"
                             Height="Auto"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>

                <!-- Manager-only section -->
                <StackPanel Grid.Row="2"
                            Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Printing Settings -->
                    <StackPanel Margin="0,24,0,0">
                        <TextBlock Text="{DynamicResource Settings.Printing}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,16"/>

                        <!-- Receipt Printer -->
                        <TextBlock Text="{DynamicResource Settings.ReceiptPrinter}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailablePrinters}"
                                      SelectedItem="{Binding SelectedReceiptPrinter}"
                                      FontSize="14"
                                      Height="32"
                                      VerticalContentAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="{DynamicResource Settings.Refresh}"
                                    Width="80" Height="32"
                                    Margin="8,0,0,0"
                                    Command="{Binding RefreshPrintersCommand}"
                                    FontSize="12"/>
                        </Grid>

                        <!-- Paper Width -->
                        <TextBlock Text="{DynamicResource Settings.PaperWidth}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,6"/>

                        <ComboBox ItemsSource="{Binding PaperWidthOptions}"
                                  SelectedItem="{Binding PaperWidth}"
                                  FontSize="14"
                                  Height="32"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,0,12"/>

                        <!-- Auto Print -->
                        <CheckBox Content="{DynamicResource Settings.AutoPrintAfterPayment}"
                                  IsChecked="{Binding AutoPrint}"
                                  FontSize="14"
                                  Margin="0,0,0,8"/>

                        <!-- Show Print Dialog -->
                        <CheckBox Content="{DynamicResource Settings.ShowWindowsPrintDialog}"
                                  IsChecked="{Binding ShowPrintDialog}"
                                  FontSize="14"
                                  Margin="0,0,0,8"/>

                        <!-- Copies -->
                        <TextBlock Text="{DynamicResource Settings.Copies}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 Width="60" Height="32"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,12"/>

                        <!-- Test Print Action -->
                        <TextBlock Text="{DynamicResource Settings.TestPrintAction}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,12,0,6"/>
                        <ComboBox ItemsSource="{Binding TestPrintActionOptions}"
                                  SelectedValue="{Binding TestPrintAction, Mode=TwoWay}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  FontSize="14"
                                  Height="32"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,0,8"
                                  HorizontalAlignment="Stretch"/>

                        <!-- Test Print -->
                        <Button Content="{DynamicResource Settings.PrintTestReceipt}"
                                Command="{Binding PrintTestReceiptCommand}"
                                Width="160" Height="36"
                                Background="#3B82F6" Foreground="White"
                                FontSize="12"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Keyboard Shortcuts Section -->
                    <StackPanel Margin="0,24,0,0">
                        <TextBlock Text="{DynamicResource Settings.KeyboardShortcuts}"
                                   Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="{DynamicResource Settings.KeyboardShortcutsDescription}"
                                   FontSize="13" Foreground="#64748B"
                                   Margin="0,0,0,12"/>

                        <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                                CornerRadius="6" Padding="12">
                            <TextBlock Text="Keyboard shortcut configuration is not available yet. This feature will be redesigned in a future update."
                                       FontSize="13" Foreground="#92400E"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
