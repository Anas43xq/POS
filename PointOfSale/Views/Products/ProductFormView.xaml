<Window x:Class="UI.Views.ProductFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Product"
        Width="560" Height="660"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="ProductFormView_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- ── Section caption — small-caps group header used to chunk the form ── -->
        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{StaticResource ModalTextMuted}"/>
        </Style>

        <!-- ── Field TextBox (no central equivalent — DialogChrome only styles the border) ── -->
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FontSize"                 Value="12.5"/>
            <Setter Property="Foreground"               Value="{StaticResource ModalTextDark}"/>
            <Setter Property="CaretBrush"                Value="{StaticResource ModalBrandDark}"/>
            <Setter Property="VerticalContentAlignment"  Value="Center"/>
            <Setter Property="Padding"                   Value="10,0"/>
            <Setter Property="FocusVisualStyle"          Value="{x:Null}"/>
        </Style>

        <Style x:Key="FieldTextBoxMulti" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
            <Setter Property="AcceptsReturn"            Value="True"/>
            <Setter Property="TextWrapping"             Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding"                  Value="10,8"/>
        </Style>

        <!-- ── CheckBox (no central equivalent) ── -->
        <Style x:Key="FieldCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize"                 Value="12.5"/>
            <Setter Property="Foreground"               Value="{StaticResource ModalTextDark}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor"                   Value="Hand"/>
        </Style>

        <!-- ── ComboBox (local — DialogChrome has no ComboBox style; kept identical
                 in shape/metrics to AddEditCategoryDialog's version for consistency) ── -->
        <Style x:Key="FieldComboBox" TargetType="ComboBox">
            <Setter Property="Background"               Value="{StaticResource ModalBrandLight}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource ModalBrandBorder}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="FontSize"                 Value="12.5"/>
            <Setter Property="Foreground"               Value="{StaticResource ModalTextDark}"/>
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="▾" FontSize="10"
                                           Foreground="{StaticResource ModalBrandDark}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen,
                                          RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True">
                                <Border Background="White"
                                        BorderBrush="{StaticResource ModalBrandBorder}"
                                        BorderThickness="1" CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{StaticResource ModalBrandDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding"    Value="10,8"/>
            <Setter Property="FontSize"   Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource ModalTextDark}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DBEEFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Inline validation / info banner ── -->
        <Style x:Key="WarningBanner" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource ModalErrorBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource ModalErrorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="12,9"/>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- Transparent-tinted overlay — click outside the card closes the dialog -->
    <Grid x:Name="OverlayGrid"
          Background="#4D0F2A4A"
          MouseDown="OverlayGrid_MouseDown">

        <!-- Dialog card -->
        <Border x:Name="DialogCard"
                Width="560"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Style="{StaticResource ModalCardBorder}"
                MouseDown="DialogCard_MouseDown">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header          -->
                    <RowDefinition Height="Auto"/>
                    <!-- Warning banners -->
                    <RowDefinition Height="*"/>
                    <!-- Form body       -->
                    <RowDefinition Height="Auto"/>
                    <!-- Footer          -->
                </Grid.RowDefinitions>

                <!-- ── HEADER ── -->
                <Border Grid.Row="0"
                        Style="{StaticResource ModalHeaderBorder}"
                        Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="7"
                                    Background="{StaticResource ModalBrandDark}"
                                    Margin="0,0,10,0">
                                <TextBlock Text="📦" FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding FormTitle, FallbackValue='Add Product'}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource ModalTextDark}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="✕" FontSize="13"
                                Style="{StaticResource ModalCloseButton}"
                                Command="{Binding CancelCommand}"/>
                    </Grid>
                </Border>

                <!-- ── WARNING / ERROR BANNERS ── -->
                <StackPanel Grid.Row="1" Margin="18,12,18,0">

                    <!-- General validation error (required fields, negative price, etc.) -->
                    <Border Style="{StaticResource WarningBanner}"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠ " FontSize="13" Foreground="{StaticResource ModalErrorFg}"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="11.5" Foreground="{StaticResource ModalErrorFg}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Duplicate product name warning -->
                    <Border Style="{StaticResource WarningBanner}"
                            Visibility="{Binding ProductExistsWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠ " FontSize="13" Foreground="{StaticResource ModalErrorFg}"/>
                            <TextBlock Text="A product with this name already exists in the selected category."
                                       FontSize="11.5" Foreground="{StaticResource ModalErrorFg}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── FORM BODY ── -->
                <StackPanel Grid.Row="2" Margin="18,16,18,6">

                    <!-- ═══ Basic Information ═══ -->
                    <TextBlock Text="BASIC INFORMATION" Style="{StaticResource SectionCaption}" Margin="0,0,0,10"/>

                    <TextBlock Text="Product Name" Style="{StaticResource ModalLabel}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource ModalInputBorder}" Height="40" Margin="0,0,0,12">
                        <TextBox Style="{StaticResource FieldTextBox}"
                                 Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                                 Color="#B8D8F5"/>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>

                    <TextBlock Text="Category" Style="{StaticResource ModalLabel}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource FieldComboBox}"
                              ItemsSource="{Binding CategoryOptions}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"
                              Margin="0,0,0,18"/>

                    <!-- ═══ Pricing &amp; Tax ═══ -->
                    <TextBlock Text="PRICING &amp; TAX" Style="{StaticResource SectionCaption}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Price (AED)" Style="{StaticResource ModalLabel}" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource ModalInputBorder}" Height="40">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="AED"
                                               FontSize="10" Foreground="{StaticResource ModalTextMuted}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource FieldTextBox}"
                                             Text="{Binding Price, UpdateSourceTrigger=PropertyChanged,
                                                    StringFormat=N2}"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tax" Style="{StaticResource ModalLabel}" Margin="0,0,0,6"/>
                            <ComboBox Style="{StaticResource FieldComboBox}"
                                      ItemsSource="{Binding TaxOptions}"
                                      SelectedItem="{Binding SelectedTax}"
                                      DisplayMemberPath="Name"/>
                        </StackPanel>
                    </Grid>

                    <!-- Additional tax — checkbox + conditional amount, grouped with Pricing -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  Style="{StaticResource FieldCheckBox}"
                                  Content="Additional tax"
                                  IsChecked="{Binding HasAdditionalTax}"
                                  VerticalAlignment="Center"/>

                        <Border Grid.Column="2"
                                Style="{StaticResource ModalInputBorder}" Height="36"
                                Visibility="{Binding HasAdditionalTax, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="AED"
                                           FontSize="10" Foreground="{StaticResource ModalTextMuted}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource FieldTextBox}"
                                         Text="{Binding AdditionalTaxAmount,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ═══ Visibility &amp; Notes ═══ -->
                    <TextBlock Text="VISIBILITY &amp; NOTES" Style="{StaticResource SectionCaption}" Margin="0,0,0,10"/>

                    <Border Background="{StaticResource ModalBrandLight}"
                            BorderBrush="{StaticResource ModalBrandBorder}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,11" Margin="0,0,0,14">
                        <CheckBox Style="{StaticResource FieldCheckBox}"
                                  Content="Is active (visible to cashiers)"
                                  IsChecked="{Binding IsActive}"
                                  FontWeight="Medium"/>
                    </Border>

                    <TextBlock Style="{StaticResource ModalLabel}" Margin="0,0,0,6">
                        <Run Text="Description"/>
                        <Run Text=" · optional"
                             Foreground="{StaticResource ModalTextMuted}"
                             FontWeight="Normal"/>
                    </TextBlock>
                    <Border Style="{StaticResource ModalInputBorder}" Height="66">
                        <TextBox Style="{StaticResource FieldTextBoxMulti}"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>

                </StackPanel>

                <!-- ── FOOTER ── -->
                <Border Grid.Row="3"
                        Style="{StaticResource ModalFooterBorder}"
                        Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource OutlineBtn}"
                                Content="🌐 Translations…"
                                Command="{Binding TranslationsCommand}"
                                HorizontalAlignment="Left"
                                Padding="14,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource OutlineBtn}"
                                    Content="Cancel" Margin="0,0,8,0"
                                    Command="{Binding CancelCommand}"/>
                            <Button Style="{StaticResource PrimaryGradientBtn}"
                                    Content="{Binding SaveButtonLabel, FallbackValue='Save Product'}"
                                    Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
