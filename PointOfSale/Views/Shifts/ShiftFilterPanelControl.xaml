<!--
    ╔══════════════════════════════════════════════════════╗
    ║   ShiftFilterPanelControl                            ║
    ║   Page-specific filter bar for Shift Management.     ║
    ║                                                       ║
    ║   Composes:                                           ║
    ║     • Status filter (Open / Closed / All)             ║
    ║     • Shared <controls:DateRangeFilterControl/>        ║
    ║     • Refresh button (far right)                      ║
    ║                                                       ║
    ║   Deliberately does NOT include a search box or a     ║
    ║   void button — those belong to the Transactions     ║
    ║   page, not Shifts.                                   ║
    ║                                                       ║
    ║   No DataContext of its own — inherits the host VM.  ║
    ╚══════════════════════════════════════════════════════╝
-->
<UserControl x:Class="UI.Views.ShiftFilterPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             mc:Ignorable="d" d:DesignHeight="46" d:DesignWidth="1420">

    <UserControl.Resources>
        <!-- Same visual language as DateInput (height/border/radius),
             just for ComboBox — kept local to this panel so the host
             page isn't required to provide it. -->
        <Style x:Key="ShiftFilterCombo" TargetType="ComboBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource BrandLight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource FilterPanel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- ── Status filter ───────────────────────────────────── -->
                <TextBlock Text="{DynamicResource Manager.Shifts.StatusFilter}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,0,6,0"/>
                <ComboBox Style="{StaticResource ShiftFilterCombo}"
                          ItemsSource="{Binding ShiftStatusFilterOptions}"
                          SelectedItem="{Binding SelectedShiftStatusFilter, Mode=TwoWay}"
                          DisplayMemberPath="Label"/>

                <!-- Divider between status filter and date range -->
                <Border Width="1" Height="20"
                        Background="{StaticResource BrandBorder}"
                        Margin="12,0,10,0"/>

                <!-- ── Shared date-range mechanism ────────────────────── -->
                <controls:DateRangeFilterControl
                    DayCommand="{Binding LoadDayCommand}"
                    WeekCommand="{Binding LoadWeekCommand}"
                    MonthCommand="{Binding LoadMonthCommand}"
                    PeriodCommand="{Binding LoadPeriodCommand}"
                    ApplyCommand="{Binding ApplyPeriodCommand}"
                    IsPeriodFilterVisible="{Binding IsPeriodFilterVisible}"
                    FromDate="{Binding FromDate, Mode=TwoWay}"
                    ToDate="{Binding ToDate, Mode=TwoWay}"
                    DayLabel="{DynamicResource Common.Day}"
                    WeekLabel="{DynamicResource Common.Week}"
                    MonthLabel="{DynamicResource Common.Month}"
                    PeriodLabel="{DynamicResource Common.Period}"
                    FromLabel="{DynamicResource Common.From}"
                    ToLabel="{DynamicResource Common.To}"
                    ApplyButtonText="{DynamicResource Common.Apply}"/>
            </StackPanel>

            <!-- Refresh, far right -->
            <Button Grid.Column="1"
                    Style="{StaticResource OutlineBtn}"
                    Content="{DynamicResource Common.Refresh}"
                    Command="{Binding RefreshCommand}"/>
        </Grid>
    </Border>
</UserControl>
