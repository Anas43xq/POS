<Window x:Class="UI.Views.EndDayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="End Day" Height="600" Width="470"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ModalCardBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header  -->
                <RowDefinition Height="*"/>     <!-- Body    -->
                <RowDefinition Height="Auto"/>  <!-- Footer  -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource ModalHeaderBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7"
                                Background="{StaticResource ModalBrandDark}"
                                Margin="0,0,9,0">
                            <TextBlock Text="☾" FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Shift.End.Title}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModalTextDark}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource ModalCloseButton}"
                            Content="&#x2715;"
                            FontSize="13"
                            Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14,18,8">
                <StackPanel>
                    <!-- Warning banner -->
                    <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1"
                            CornerRadius="7" Padding="12,8" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Common.Warning}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="#856404" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource Shift.WarningMessage}"
                                       FontSize="11" Foreground="#856404" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Shift summary card -->
                    <Border Style="{StaticResource ModalInputBorder}" Padding="14,10"
                            CornerRadius="8" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Shift.OpeningCash}"
                                           Foreground="{StaticResource ModalTextMuted}"/>
                                <TextBlock Text="{Binding OpeningCashDisplay}" Grid.Column="1"
                                           FontWeight="SemiBold" Foreground="{StaticResource ModalTextDark}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Shift.TotalSales}"
                                           Foreground="{StaticResource ModalTextMuted}"/>
                                <TextBlock Text="{Binding TotalSalesDisplay}" Grid.Column="1"
                                           FontWeight="SemiBold" Foreground="{StaticResource ModalTextDark}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Shift.ExpectedCash}"
                                           Foreground="{StaticResource ModalTextMuted}"/>
                                <TextBlock Text="{Binding ExpectedCashDisplay}" Grid.Column="1"
                                           FontWeight="SemiBold" Foreground="{StaticResource ModalTextDark}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Closing cash input -->
                    <TextBlock Text="{DynamicResource Shift.ActualClosingCash}"
                               Style="{StaticResource ModalLabel}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource ModalInputBorder}" Height="42" CornerRadius="7">
                        <TextBox x:Name="ClosingCashBox"
                                 Text="{Binding ClosingCash, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="10,0" FontSize="14"
                                 Foreground="{StaticResource ModalTextDark}"
                                 VerticalContentAlignment="Center"
                                 PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                 DataObject.Pasting="DecimalTextBox_Pasting"
                                 LostFocus="DecimalTextBox_LostFocus"
                                 Loaded="ClosingCashBox_Loaded"
                                 KeyDown="ClosingCashBox_KeyDown"/>
                    </Border>

                    <!-- Cash difference -->
                    <Border Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="1"
                            CornerRadius="7" Padding="12,8" Margin="0,14,0,0"
                            Visibility="{Binding ShowCashDifference, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Shift.CashDifference}"
                                       FontWeight="SemiBold" Foreground="#2E7D32"/>
                            <TextBlock Text="{Binding CashDifferenceDisplay}" Grid.Column="1"
                                       FontWeight="SemiBold" Foreground="#2E7D32"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ModalErrorFg}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Style="{StaticResource ModalFooterBorder}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlineBtn}"
                            Content="{DynamicResource Common.Cancel}"
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"/>
                    <Button Style="{StaticResource DangerBtn}"
                            Content="{DynamicResource Shift.End.Button}"
                            Command="{Binding EndDayCommand}"
                            Click="EndDayButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
