<Window x:Class="UI.Views.StartDayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start Day" Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ModalCardBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="*"/>     <!-- Body   -->
                <RowDefinition Height="Auto"/>  <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource ModalHeaderBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7"
                                Background="{StaticResource ModalBrandDark}"
                                Margin="0,0,9,0">
                            <TextBlock Text="☀" FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource Shift.Start.Title}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModalTextDark}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource ModalCloseButton}"
                            Content="&#x2715;"
                            FontSize="13"
                            Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="18,16,18,8">
                <TextBlock Text="{DynamicResource Shift.Start.Description}"
                           FontSize="12" Foreground="{StaticResource ModalTextMuted}"
                           TextWrapping="Wrap" Margin="0,0,0,16"/>

                <TextBlock Text="{DynamicResource Shift.OpeningCash}"
                           Style="{StaticResource ModalLabel}"
                           Margin="0,0,0,6"/>
                <Border Style="{StaticResource ModalInputBorder}" Height="42" CornerRadius="7">
                    <TextBox x:Name="OpeningCashBox"
                             Text="{Binding OpeningCash, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Padding="10,0" FontSize="14"
                             Foreground="{StaticResource ModalTextDark}"
                             VerticalContentAlignment="Center"
                             Loaded="OpeningCashBox_Loaded"
                             KeyDown="OpeningCashBox_KeyDown"
                             PreviewTextInput="OpeningCashBox_PreviewTextInput"/>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ModalErrorFg}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Style="{StaticResource ModalFooterBorder}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlineBtn}"
                            Content="{DynamicResource Common.Cancel}"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Command="{Binding CancelCommand}"/>
                    <Button Style="{StaticResource PrimaryGradientBtn}"
                            Content="{DynamicResource Shift.Start.Button}"
                            IsDefault="True"
                            Command="{Binding StartDayCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
