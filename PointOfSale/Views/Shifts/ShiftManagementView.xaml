<!--
    ╔══════════════════════════════════════════════════════╗
    ║   Cafeteria Hawa POS  –  Manager · Shift Management  ║
    ║   Filter bar + ManagerDataGrid + pagination          ║
    ║                                                       ║
    ║   The filter bar lives in its own UserControl         ║
    ║   (<views:ShiftFilterPanelControl/>). The grid reuses  ║
    ║   the same chrome as the Transactions page so the     ║
    ║   two list screens stay visually consistent.          ║
    ╚══════════════════════════════════════════════════════╝
-->
<UserControl x:Class="UI.Views.ShiftManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             xmlns:views="clr-namespace:UI.Views"
             mc:Ignorable="d"
             d:DesignWidth="1420" d:DesignHeight="820">

    <UserControl.Resources>

        <!-- Shift status badge border (Open / Closed) -->
        <Style x:Key="ShiftStatusBadgeBorderStyle" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusLabel}" Value="Open">
                    <Setter Property="Background" Value="{StaticResource SuccessLight}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="Closed">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shift status badge text (Open / Closed) -->
        <Style x:Key="ShiftStatusBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusLabel}" Value="Open">
                    <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="Closed">
                    <Setter Property="Foreground" Value="{StaticResource BrandDark}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Currency cell: green when Difference is present, muted when null -->
        <Style x:Key="ShiftDifferenceCellStyle" TargetType="controls:CurrencyText">
            <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CashDifference}" Value="{x:Null}">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="#EAF4FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Filter bar -->
            <RowDefinition Height="*"/>
            <!-- Table card -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════
             FILTER BAR
             ══════════════════════════════════════ -->
        <views:ShiftFilterPanelControl Grid.Row="0"/>

        <!-- ══════════════════════════════════════
             SHIFTS TABLE CARD
             ══════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- header -->
                    <RowDefinition Height="*"/>
                    <!-- grid   -->
                    <RowDefinition Height="Auto"/>
                    <!-- pager  -->
                </Grid.RowDefinitions>

                <!-- Card header -->
                <Border Grid.Row="0" Style="{StaticResource CardHeaderBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Manager.Shifts.CardTitle}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource Manager.Shifts.Loading}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- Shifts DataGrid. No SelectedItem binding — the host
                     ViewModel does not expose a SelectedShift property,
                     and Shift ID is opened via the per-row button. -->
                <DataGrid x:Name="ShiftsGrid"
                          Grid.Row="1"
                          Style="{StaticResource ManagerDataGrid}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ItemsSource="{Binding ShiftsView}">
                    <DataGrid.Columns>

                        <!-- Shift ID — clickable button (opens ShiftDetailView) -->
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Shifts.ColShiftId}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ShiftId}"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            Cursor="Hand"
                                            HorizontalAlignment="Left"
                                            Foreground="{StaticResource BrandDark}"
                                            Command="{Binding DataContext.OpenShiftDetailCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg"
                                                        Background="{StaticResource BrandLight}"
                                                        CornerRadius="4"
                                                        Padding="8,2">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#C4DDF5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cashier -->
                        <DataGridTextColumn Header="{DynamicResource Manager.Shifts.ColCashier}"
                                            Binding="{Binding CashierName}" Width="140"/>

                        <!-- Opened At -->
                        <DataGridTextColumn Header="{DynamicResource Manager.Shifts.ColOpenedAt}"
                                            Binding="{Binding OpenedAt, StringFormat='yyyy-MM-dd HH:mm'}"
                                            Width="150"/>

                        <!-- Closed At -->
                        <DataGridTextColumn Header="{DynamicResource Manager.Shifts.ColClosedAt}"
                                            Binding="{Binding ClosedAt, StringFormat='yyyy-MM-dd HH:mm'}"
                                            Width="150"/>

                        <!-- Opening Cash (right-aligned) -->
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Shifts.ColOpening}" Width="120">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagerDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CurrencyText Amount="{Binding OpeningCash}"
                                                           Foreground="{StaticResource TextDark}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Closing Cash (right-aligned) -->
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Shifts.ColClosing}" Width="120">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagerDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CurrencyText Amount="{Binding ClosingCash}"
                                                           Foreground="{StaticResource TextDark}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Expected Cash (right-aligned) -->
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Shifts.ColExpected}" Width="120">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagerDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CurrencyText Amount="{Binding ExpectedCash}"
                                                           Foreground="{StaticResource TextDark}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Difference (right-aligned) — color via ShiftDifferenceCellStyle -->
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Shifts.ColDifference}" Width="120">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagerDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:CurrencyText Amount="{Binding CashDifference}"
                                                           Style="{StaticResource ShiftDifferenceCellStyle}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status badge -->
                        <DataGridTemplateColumn Header="{DynamicResource Manager.Shifts.ColStatus}" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Style="{StaticResource ShiftStatusBadgeBorderStyle}">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   Style="{StaticResource ShiftStatusBadgeTextStyle}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Duration -->
                        <DataGridTextColumn Header="{DynamicResource Manager.Shifts.ColDuration}"
                                            Binding="{Binding DurationHours, StringFormat={}{0:F1}h}"
                                            Width="90"/>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination footer -->
                <Border Grid.Row="2"
                        Background="{StaticResource CardHdrBg}"
                        BorderBrush="{StaticResource BrandBorder}"
                        BorderThickness="0,0.5,0,0"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                                <Run Text="{DynamicResource Common.Page}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding PageInfo, Mode=OneWay}"/>
                                <Run Text="  ·  "/>
                                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                                <Run Text=" "/>
                                <Run Text="{DynamicResource Manager.Shifts.PagerSuffix}"/>
                            </TextBlock>
                            <!-- Error banner -->
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="11" Foreground="{StaticResource DangerMid}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource OutlineBtn}"
                                    Content="{DynamicResource Common.Previous}"
                                    Margin="0,0,6,0"
                                    Command="{Binding PreviousPageCommand}"/>
                            <Button Style="{StaticResource PrimaryGradientBtn}"
                                    Content="{DynamicResource Common.Next}"
                                    Command="{Binding NextPageCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
