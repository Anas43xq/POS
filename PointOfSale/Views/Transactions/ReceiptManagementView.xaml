<!--
    ╔══════════════════════════════════════════════════════╗
    ║   Cafeteria Hawa POS  –  Manager · Receipts          ║
    ║   Filter bar + tabbed card (Sales / VAT / Non-VAT).   ║
    ║                                                       ║
    ║   Visual language matches Home, Transactions,         ║
    ║   Shift Management, and Reports.  All shared styles   ║
    ║   are pulled from the App-level merged dictionaries   ║
    ║   (Brushes / Buttons / Lists / DataGrid / FilterField)║
    ║   so this view has no locally redefined resources.    ║
    ╚══════════════════════════════════════════════════════╝
-->
<UserControl x:Class="UI.Views.ReceiptManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             xmlns:views="clr-namespace:UI.Views"
             mc:Ignorable="d"
             d:DesignWidth="1420" d:DesignHeight="820">

    <UserControl.Resources>
        <!--
            Status badge (Sales tab) — inherits the shared BadgeBase
            / BadgeText styles and only changes the colour per
            status.  Mirrors the TransactionsView badge style.
        -->
        <Style x:Key="ReceiptStatusBadgeBorderStyle" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Voided">
                    <Setter Property="Background" Value="{StaticResource DangerLight}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Background" Value="#FEF3C7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReceiptStatusBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{StaticResource BrandDark}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Voided">
                    <Setter Property="Foreground" Value="{StaticResource DangerDark}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Foreground" Value="#92400E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#EAF4FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Page header -->
            <RowDefinition Height="Auto"/>  <!-- Filter bar  -->
            <RowDefinition Height="*"/>     <!-- Tabs / grid  -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════
             PAGE HEADER
             ══════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="16,16,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Manager.Receipt.Title}"
                               FontSize="18"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextDark}"/>
                    <TextBlock Text="{DynamicResource Manager.Receipt.Subtitle}"
                               FontSize="12"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource DangerRed}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="500"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════
             FILTER BAR
             ══════════════════════════════════════ -->
        <views:ReceiptFilterPanelControl Grid.Row="1" Margin="16,0,16,12"/>

        <!-- ══════════════════════════════════════
             TABS + TABLES
             ══════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="16,0,16,16">
            <TabControl Background="Transparent" BorderThickness="0" Padding="0" Margin="0">
                <TabItem Header="{DynamicResource Manager.Receipt.TabSales}" Style="{StaticResource ManagerTabItem}">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardHeaderBorder}">
                            <TextBlock Text="{DynamicResource Manager.Receipt.SalesReceiptsTitle}"
                                       Style="{StaticResource CardTitle}"/>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  Style="{StaticResource ManagerDataGrid}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  ItemsSource="{Binding SalesReceipts}"
                                  SelectedItem="{Binding SelectedSalesReceipt, Mode=TwoWay}"
                                  BorderThickness="0"
                                  Background="White">
                            <DataGrid.Columns>
                                <!--
                                    Receipt number is a clickable pill that
                                    invokes OpenSalesReceiptCommand — same
                                    pattern used by TransactionsView.  No
                                    standalone "Open" button is needed in
                                    the toolbar above.
                                -->
                                <DataGridTemplateColumn Header="{DynamicResource Manager.Receipt.ColReceiptNumber}" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding ReceiptNumber}"
                                                    FontSize="11"
                                                    Cursor="Hand"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    Foreground="{StaticResource BrandDark}"
                                                    BorderThickness="0"
                                                    Padding="0,0,0,0"
                                                    Command="{Binding DataContext.OpenSalesReceiptCommand,
                                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" Background="#DBEEFF" CornerRadius="4" Padding="8,3">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#C4DDF5"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource Common.Date}"
                                                    Binding="{Binding TransactionDate, StringFormat=d}" Width="1*"/>
                                <DataGridTextColumn Header="{DynamicResource Common.PaymentMethod}"
                                                    Binding="{Binding PaymentMethod}" Width="1.2*"/>
                                <DataGridTemplateColumn Header="{DynamicResource Common.GrandTotal}" Width="1*">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagerDataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:CurrencyText Amount="{Binding GrandTotal}"
                                                                   Foreground="{StaticResource TextDark}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource Common.Status}" Width="0.8*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Style="{StaticResource ReceiptStatusBadgeBorderStyle}">
                                                <TextBlock Text="{Binding Status}"
                                                           Style="{StaticResource ReceiptStatusBadgeTextStyle}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource Manager.Receipt.TabVatPurchases}" Style="{StaticResource ManagerTabItem}">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardHeaderBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource Manager.Receipt.VatPurchaseReceiptsTitle}"
                                           Style="{StaticResource CardTitle}"/>
                                <views:PurchaseReceiptToolbarControl Grid.Column="1"
                                                                     AddCommand="{Binding AddVatReceiptCommand}"
                                                                     EditCommand="{Binding EditVatReceiptCommand}"
                                                                     HasSelection="{Binding HasVatSelection}"
                                                                     DeleteCommand="{Binding DeleteVatReceiptCommand}"
                                                                     ViewCommand="{Binding ViewVatReceiptCommand}"
                                                                     ExportCommand="{Binding ExportVatPurchasesCommand}"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  Style="{StaticResource ManagerDataGrid}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  ItemsSource="{Binding VatReceipts}"
                                  SelectedItem="{Binding SelectedVatReceipt, Mode=TwoWay}"
                                  BorderThickness="0"
                                  Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Manager.Receipt.ColReceipt}"
                                                    Binding="{Binding InvoiceNumber}" Width="1.1*"/>
                                <DataGridTextColumn Header="{DynamicResource Common.Date}"
                                                    Binding="{Binding InvoiceDate, StringFormat=d}" Width="1*"/>
                                <DataGridTextColumn Header="{DynamicResource Manager.Receipt.ColSupplier}"
                                                    Binding="{Binding SupplierName}" Width="1.3*"/>
                                <DataGridTextColumn Header="{DynamicResource Manager.Receipt.ColCategory}"
                                                    Binding="{Binding Category}" Width="1.2*"/>
                                <DataGridTemplateColumn Header="{DynamicResource Common.Subtotal}" Width="0.9*">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagerDataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:CurrencyText Amount="{Binding Subtotal}"
                                                                   Foreground="{StaticResource TextDark}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource Manager.Receipt.ColGrandTotal}" Width="0.9*">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagerDataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:CurrencyText Amount="{Binding GrandTotal}"
                                                                   Foreground="{StaticResource TextDark}"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource Manager.Receipt.TabNonVatPurchases}" Style="{StaticResource ManagerTabItem}">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardHeaderBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource Manager.Receipt.NonVatPurchaseReceiptsTitle}"
                                           Style="{StaticResource CardTitle}"/>
                                <views:PurchaseReceiptToolbarControl Grid.Column="1"
                                                                     AddCommand="{Binding AddNonVatReceiptCommand}"
                                                                     EditCommand="{Binding EditNonVatReceiptCommand}"
                                                                     HasSelection="{Binding HasNonVatSelection}"
                                                                     DeleteCommand="{Binding DeleteNonVatReceiptCommand}"
                                                                     ViewCommand="{Binding ViewNonVatReceiptCommand}"
                                                                     ExportCommand="{Binding ExportNonVatPurchasesCommand}"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  Style="{StaticResource ManagerDataGrid}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  ItemsSource="{Binding NonVatReceipts}"
                                  SelectedItem="{Binding SelectedNonVatReceipt, Mode=TwoWay}"
                                  BorderThickness="0"
                                  Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Manager.Receipt.ColReceipt}"
                                                    Binding="{Binding InvoiceNumber}" Width="1.1*"/>
                                <DataGridTextColumn Header="{DynamicResource Common.Date}"
                                                    Binding="{Binding InvoiceDate, StringFormat=d}" Width="1*"/>
                                <DataGridTextColumn Header="{DynamicResource Manager.Receipt.ColSupplier}"
                                                    Binding="{Binding SupplierName}" Width="1.3*"/>
                                <DataGridTextColumn Header="{DynamicResource Manager.Receipt.ColCategory}"
                                                    Binding="{Binding Category}" Width="1.2*"/>
                                <DataGridTemplateColumn Header="{DynamicResource Manager.Receipt.ColGrandTotal}" Width="0.9*">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagerDataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:CurrencyText Amount="{Binding GrandTotal}"
                                                                   Foreground="{StaticResource TextDark}"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
