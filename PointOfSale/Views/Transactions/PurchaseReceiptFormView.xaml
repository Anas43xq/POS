<!--
    ╔══════════════════════════════════════════════════════╗
    ║   Purchase Receipt Form                               ║
    ║   Add / Edit / View screen for VAT and Non-VAT        ║
    ║   purchase receipts.  Same form, two layouts —        ║
    ║   one for VAT (with rate / amount fields), one for    ║
    ║   Non-VAT (single amount + notes).                    ║
    ║                                                       ║
    ║   No locally redefined resources — every style is     ║
    ║   pulled from the App-level merged dictionaries       ║
    ║   (Brushes / Buttons / Lists / DataGrid / FilterField)║
    ║   so the form matches the rest of the Manager module. ║
    ╚══════════════════════════════════════════════════════╝
-->
<UserControl x:Class="UI.Views.PurchaseReceiptFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="520">

    <Grid Background="#EAF4FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header  -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Footer  -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="16,16,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource OutlineBtn}"
                        Content="&#x2190;"
                        Width="38"
                        Padding="0,0,0,0"
                        Margin="0,0,12,0"
                        Command="{Binding CancelReceiptCommand}"
                        ToolTip="Back"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding FormTitle}"
                           FontSize="16"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextDark}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource DangerRed}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="500"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ═══ FORM CONTENT ═══ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="16,0,16,12">
            <Grid>
                <!-- VAT mode form -->
                <Grid Visibility="{Binding IsVatReceiptMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Supplier | Receipt Number -->
                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="{DynamicResource Common.Supplier}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource FilterField}"
                                  ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier}"
                                  DisplayMemberPath="CompanyName"
                                  IsEnabled="{Binding IsFormEditable}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="0">
                        <TextBlock Text="{DynamicResource Common.ReceiptNumber}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FilterField}"
                                 Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsFormEditable}"
                                 Padding="8,0"/>
                    </StackPanel>

                    <!-- Row 2: Date | Category -->
                    <StackPanel Grid.Column="0" Grid.Row="2">
                        <TextBlock Text="{DynamicResource Common.Date}" Style="{StaticResource FieldLabel}"/>
                        <DatePicker Style="{StaticResource FilterField}"
                                    SelectedDate="{Binding InvoiceDate}"
                                    IsEnabled="{Binding IsFormEditable}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="2">
                        <TextBlock Text="{DynamicResource Common.Category}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FilterField}"
                                 Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsFormEditable}"
                                 Padding="8,0"/>
                    </StackPanel>

                    <!-- Row 4: Subtotal | VAT Rate -->
                    <StackPanel Grid.Column="0" Grid.Row="4">
                        <TextBlock Text="{DynamicResource Common.Subtotal}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FilterField}"
                                 Text="{Binding Subtotal, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsFormEditable}"
                                 Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="4">
                        <TextBlock Text="{DynamicResource Manager.Receipt.FieldVatRate}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FilterField}"
                                 Text="{Binding VatRate, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsFormEditable}"
                                 Padding="8,0"/>
                    </StackPanel>

                    <!-- Row 6: VAT Amount | Grand Total -->
                    <StackPanel Grid.Column="0" Grid.Row="6">
                        <TextBlock Text="{DynamicResource Manager.Receipt.FieldVatAmount}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FilterField}"
                                 Text="{Binding VatAmount, StringFormat=N2, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="#E5EEF8"
                                 Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="6">
                        <TextBlock Text="{DynamicResource Common.GrandTotal}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FilterField}"
                                 Text="{Binding GrandTotal, StringFormat=N2, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="#E5EEF8"
                                 FontWeight="SemiBold"
                                 Padding="8,0"/>
                    </StackPanel>

                    <!-- Row 8: Notes -->
                    <StackPanel Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="3">
                        <TextBlock Text="{DynamicResource Common.Notes}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FilterField}"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsFormEditable}"
                                 Padding="8,0"
                                 Height="32"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Non-VAT mode form -->
                <Grid Visibility="{Binding IsNonVatReceiptMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Supplier | Receipt Number -->
                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="{DynamicResource Common.Supplier}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource FilterField}"
                                  ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier}"
                                  DisplayMemberPath="CompanyName"
                                  IsEnabled="{Binding IsFormEditable}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="0">
                        <TextBlock Text="{DynamicResource Common.ReceiptNumber}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FilterField}"
                                 Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsFormEditable}"
                                 Padding="8,0"/>
                    </StackPanel>

                    <!-- Row 2: Date | Category -->
                    <StackPanel Grid.Column="0" Grid.Row="2">
                        <TextBlock Text="{DynamicResource Common.Date}" Style="{StaticResource FieldLabel}"/>
                        <DatePicker Style="{StaticResource FilterField}"
                                    SelectedDate="{Binding InvoiceDate}"
                                    IsEnabled="{Binding IsFormEditable}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="2">
                        <TextBlock Text="{DynamicResource Common.Category}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FilterField}"
                                 Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsFormEditable}"
                                 Padding="8,0"/>
                    </StackPanel>

                    <!-- Row 4: Amount | Notes -->
                    <StackPanel Grid.Column="0" Grid.Row="4">
                        <TextBlock Text="{DynamicResource Common.Amount}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FilterField}"
                                 Text="{Binding Subtotal, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsFormEditable}"
                                 FontWeight="SemiBold"
                                 Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="4">
                        <TextBlock Text="{DynamicResource Common.Notes}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FilterField}"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsFormEditable}"
                                 Padding="8,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ FOOTER ═══ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="16,0,16,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PrimaryGradientBtn}"
                        Content="{DynamicResource Common.Save}"
                        Margin="0,0,10,0"
                        Command="{Binding SaveReceiptCommand}"
                        Visibility="{Binding IsFormEditable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Style="{StaticResource OutlineBtn}"
                        Content="{DynamicResource Common.Cancel}"
                        Command="{Binding CancelReceiptCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
