<Window x:Class="UI.Views.ManagerLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:UI.Behaviors"
        Title="Manager Login"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DialogChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Transparent inner TextBox — ModalInputBorder only styles the
                 border/background, so (as in AddEditCategoryDialog) the box
                 itself needs a local style with no border of its own. -->
            <Style x:Key="FieldTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource ModalTextDark}"/>
                <Setter Property="CaretBrush" Value="{StaticResource ModalBrandDark}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>

            <!-- Same treatment for PasswordBox (no shared style exists yet). -->
            <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource ModalTextDark}"/>
                <Setter Property="CaretBrush" Value="{StaticResource ModalBrandDark}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ModalCardBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Body   -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource ModalHeaderBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7"
                                Background="{StaticResource ModalBrandDark}"
                                Margin="0,0,9,0">
                            <TextBlock Text="&#128274;" FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource ManagerLogin.Title}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource ModalTextDark}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource ModalCloseButton}"
                            Content="&#x2715;"
                            FontSize="13"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="20,18,20,4">

                <!-- Illustration — secondary to the form, kept small -->
                <Image Source="pack://application:,,,/UI;component/Assets/ManagerLoginIllustration.png"
                       Height="92"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

                <TextBlock Text="{DynamicResource ManagerLogin.Subtitle}"
                           FontSize="12"
                           Foreground="{StaticResource ModalTextMuted}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,18"/>

                <!-- Username -->
                <TextBlock Text="{DynamicResource Login.Username}" Style="{StaticResource ModalLabel}" Margin="0,0,0,6"/>
                <Border Style="{StaticResource ModalInputBorder}" Height="40" Margin="0,0,0,14">
                    <TextBox x:Name="UsernameBox"
                             Style="{StaticResource FieldTextBox}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             IsReadOnly="{Binding IsUsernameReadOnly}"
                             behaviors:FocusExtension.IsFocused="{Binding FocusUsername}">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                             Color="#B8D8F5"/>
                        </TextBox.Resources>
                    </TextBox>
                </Border>

                <!-- Password -->
                <TextBlock Text="{DynamicResource Login.Password}" Style="{StaticResource ModalLabel}" Margin="0,0,0,6"/>
                <Border Style="{StaticResource ModalInputBorder}" Height="40" Margin="0,0,0,4">
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource FieldPasswordBox}"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 behaviors:FocusExtension.IsFocused="{Binding FocusPassword}">
                        <PasswordBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                             Color="#B8D8F5"/>
                        </PasswordBox.Resources>
                    </PasswordBox>
                </Border>

                <!-- Error banner -->
                <Border Background="{StaticResource ModalErrorBg}"
                        BorderBrush="{StaticResource ModalErrorBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,9"
                        Margin="0,14,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#9888; " FontSize="12"
                                   Foreground="{StaticResource ModalErrorFg}"
                                   VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource ModalErrorFg}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Style="{StaticResource ModalFooterBorder}" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Common.Cancel}"
                            Style="{StaticResource OutlineBtn}"
                            Click="CancelButton_Click"
                            IsCancel="True"
                            MinWidth="96"
                            Padding="16,0"
                            Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource ManagerLogin.LoginButton}"
                            Style="{StaticResource PrimaryGradientBtn}"
                            Command="{Binding LoginCommand}"
                            IsDefault="True"
                            MinWidth="96"
                            Padding="16,0"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>

</Window>
